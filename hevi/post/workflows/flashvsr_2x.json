{
  "load": {
    "class_type": "VHS_LoadVideoPath",
    "inputs": {
      "video": "__VIDEO_PATH__",
      "force_rate": 0.0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "vsr": {
    "class_type": "AILab_FlashVSR_Advanced",
    "inputs": {
      "frames": ["load", 0],
      "model_version": "Tiny Long (Low VRAM)",
      "scale": 2,
      "enable_tiling": true,
      "tile_size": 256,
      "tile_overlap": 24,
      "speed_optimization": 2.0,
      "quality_boost": 2.0,
      "stability_level": 11,
      "color_fix": true,
      "vae_tiling": true,
      "unload_model": true,
      "sageattention": "disable",
      "device": "auto",
      "precision": "bf16",
      "seed": 1
    }
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["vsr", 0],
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "__OUTPUT__",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
