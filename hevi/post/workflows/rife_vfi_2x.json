{
  "load": {
    "class_type": "VHS_LoadVideoPath",
    "inputs": {
      "video": "__VIDEO_PATH__",
      "force_rate": 0.0,
      "custom_width": 0,
      "custom_height": 0,
      "frame_load_cap": 0,
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "interp_model": {
    "class_type": "FrameInterpolationModelLoader",
    "inputs": {
      "model_name": "__RIFE_MODEL__"
    }
  },
  "rife": {
    "class_type": "FrameInterpolate",
    "inputs": {
      "interp_model": ["interp_model", 0],
      "images": ["load", 0],
      "multiplier": "__MULTIPLIER__"
    }
  },
  "save": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["rife", 0],
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "__OUTPUT__",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true
    }
  }
}
