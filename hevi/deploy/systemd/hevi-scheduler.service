[Unit]
Description=HEVI durable task scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hevi
Group=hevi
WorkingDirectory=/opt/hevi
EnvironmentFile=/opt/hevi/.env
ExecStart=/usr/local/bin/uv run python -m hevi.scheduler.entrypoint
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hevi-scheduler

[Install]
WantedBy=multi-user.target
