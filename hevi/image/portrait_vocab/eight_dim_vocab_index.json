{"counts":{"fabric":8,"lens_optics":8,"micro_expression":8,"skin_light":8},"entries":[{"category":"fabric","en":"raw silk top","feeling":"轻盈挺括","how":"生丝面料垂落贴身，肩线处自然下坠，褶皱少而挺。","id":"FA-01","zh":"生丝上衣"},{"category":"fabric","en":"fitted merino knit sweater","feeling":"柔软贴合","how":"细针织贴合肩背，随身体起伏，领口贴颈不松垮。","id":"FA-02","zh":"美利奴针织衫"},{"category":"fabric","en":"linen shirt","feeling":"松弛透气","how":"亚麻布面带天然纹理，袖口微皱，透气松弛。","id":"FA-03","zh":"亚麻衬衫"},{"category":"fabric","en":"velvet jacket","feeling":"厚重华贵","how":"绒面吸光，轮廓处留一线暗光，垂坠厚重不飘。","id":"FA-04","zh":"天鹅绒外套"},{"category":"fabric","en":"satin dress","feeling":"顺滑光泽","how":"缎面随动作滑出光带，裙摆垂落到膝下不停摆。","id":"FA-05","zh":"缎面裙"},{"category":"fabric","en":"chiffon blouse","feeling":"轻盈透光","how":"雪纺轻薄透光，袖口随手臂动作轻摆不停留。","id":"FA-06","zh":"雪纺罩衫"},{"category":"fabric","en":"wool overcoat","feeling":"挺括保暖","how":"厚羊毛压住肩线，衣摆直落，风里不翻飞。","id":"FA-07","zh":"羊毛大衣"},{"category":"fabric","en":"cotton poplin shirt","feeling":"干净利落","how":"府绸挺而不硬，领口立住，袖口挽到小臂。","id":"FA-08","zh":"棉质府绸衬衫"},{"category":"skin_light","en":"gentle rim light","feeling":"立体分明","how":"脑后与肩缘留一圈细亮边，脸部主体仍由正面柔光照亮。","id":"SL-01","zh":"轮廓光"},{"category":"skin_light","en":"soft side light","feeling":"雕塑感","how":"光从一侧来，鼻梁一侧亮、一侧入暗，暗部仍有细节。","id":"SL-02","zh":"柔和侧光"},{"category":"skin_light","en":"soft diffuse directional light","feeling":"均匀通透","how":"大面积柔光从斜前方打来，光线方向可读，阴影边缘柔和。","id":"SL-03","zh":"方向性柔光"},{"category":"skin_light","en":"visible skin texture","feeling":"真实可信","how":"脸颊保留毛孔与细纹，粉底不盖纹理，高光处不糊。","id":"SL-04","zh":"可见皮肤纹理"},{"category":"skin_light","en":"natural skin highlights","feeling":"生动自然","how":"额头鼻尖留小块自然亮面，不拉出整片油光。","id":"SL-05","zh":"自然皮肤高光"},{"category":"skin_light","en":"soft shadow falloff","feeling":"过渡自然","how":"下颌到颈部的阴影慢慢变暗，无生硬分界线。","id":"SL-06","zh":"柔和阴影过渡"},{"category":"skin_light","en":"catchlight in the eyes","feeling":"眼神生动","how":"双眼各留一个小亮点，位置一致，眼睛因此有神。","id":"SL-07","zh":"眼神光"},{"category":"skin_light","en":"backlit hair glow","feeling":"轻盈透亮","how":"光从脑后打来，发丝边缘发亮，脸部仍有正面补光。","id":"SL-08","zh":"逆光发丝光"},{"category":"lens_optics","en":"85mm portrait focal length","feeling":"真实相机感","how":"用 85mm 左右焦段拍半身，脸部比例自然不拉长。","id":"LE-01","zh":"85mm 人像焦段"},{"category":"lens_optics","en":"50mm standard focal length","feeling":"平实自然","how":"50mm 视角接近人眼，环境与人物比例如实呈现。","id":"LE-02","zh":"50mm 标准焦段"},{"category":"lens_optics","en":"f/1.8 aperture","feeling":"浅景深","how":"光圈开到 f/1.8 附近，主体清楚、背景化开。","id":"LE-03","zh":"f/1.8 大光圈"},{"category":"lens_optics","en":"f/2.8 aperture","feeling":"层次分明","how":"光圈收到 f/2.8，背景仍虚化但保留可读的环境层次。","id":"LE-04","zh":"f/2.8 光圈"},{"category":"lens_optics","en":"shallow depth of field","feeling":"主体突出","how":"焦点落在眼睛上，前景与背景都化开，视线直落眼睛。","id":"LE-05","zh":"浅景深"},{"category":"lens_optics","en":"subtle film grain","feeling":"胶片质感","how":"画面带一层极细的胶片颗粒，暗部不糊成一片。","id":"LE-06","zh":"细腻胶片颗粒"},{"category":"lens_optics","en":"natural optical compression","feeling":"空间紧凑","how":"长焦把前后景距离压近，背景显得贴近人物。","id":"LE-07","zh":"长焦光学压缩感"},{"category":"lens_optics","en":"background bokeh","feeling":"主体托出","how":"背景光点化成柔和圆斑，不抢人物，亮度压暗一级。","id":"LE-08","zh":"背景虚化"},{"category":"micro_expression","en":"smile just forming","feeling":"生动自然","how":"嘴角刚动，笑意未满，眼角先弯。","id":"EX-01","zh":"浅笑刚起"},{"category":"micro_expression","en":"knowing glance held softly","feeling":"含蓄有戏","how":"眼睛看向镜头外一处，像刚听懂一句玩笑。","id":"EX-02","zh":"会意的一瞥"},{"category":"micro_expression","en":"mid-reaction, unposed","feeling":"抓拍感","how":"动作做到一半被叫住，表情停在反应正中间。","id":"EX-03","zh":"反应进行中"},{"category":"micro_expression","en":"not noticing the camera","feeling":"自然不摆拍","how":"眼睛落在手头的事上，完全没看镜头方向。","id":"EX-04","zh":"未察觉镜头"},{"category":"micro_expression","en":"mid-sentence pause","feeling":"有故事感","how":"嘴唇微张像要说话，话未出口先停住。","id":"EX-05","zh":"话到嘴边"},{"category":"micro_expression","en":"downcast gaze, lost in thought","feeling":"安静沉浸","how":"眼睛垂向下方，不看镜头，神思落在别处。","id":"EX-06","zh":"垂目出神"},{"category":"micro_expression","en":"holding back a laugh","feeling":"俏皮真实","how":"嘴角压着笑，眼里已先笑出来，肩膀不动。","id":"EX-07","zh":"忍住笑"},{"category":"micro_expression","en":"glance back over the shoulder","feeling":"抓拍感","how":"头刚转一半，眼睛先到，身体还留在原方向。","id":"EX-08","zh":"回头的一瞬"}],"source":"Extension vocabulary restated in our own words from generic photographic language (focal lengths, apertures, lighting terms, fabric names). No article text copied; no source claims an exclusive prompt. Adult portraits only; see PORTRAIT_8DIM_ATTRIBUTION.md.","total":32,"version":"1.0"}