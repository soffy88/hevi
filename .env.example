# hevi v6 — 环境变量模板
# 使用方法: cp .env.example .env 然后按注释填写各项
# 阶段说明: F1=最小闭环(LTX-2), F2=扩展(Wan/VoiceBox), F3=上线(Auth/支付)

# ─────────────────────────────────────────────────────────────────────────────
# === F1 必需 (真跑 E2E 最小资源集) ==========================================
# ─────────────────────────────────────────────────────────────────────────────

# fal.ai API Key — LTX-2 视频生成
FAL_API_KEY=

# fal.ai LTX-2 计费 tier: fast (默认) | pro
LTX2_DEFAULT_TIER=fast

# PostgreSQL 连接串
DATABASE_URL=postgresql://hevi:hevi@localhost:5432/hevi

# PostgreSQL 密码
POSTGRES_PASSWORD=hevi

# MinIO 对象存储
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=hevi-assets

# ─────────────────────────────────────────────────────────────────────────────
# === F2 扩展 (Wan 视频 / VoiceBox TTS / Duix Avatar) =======================
# ─────────────────────────────────────────────────────────────────────────────

# Alibaba DashScope — Wan 视频生成 (wan2.1-i2v-turbo)
# 提供方: 阿里云控制台 → DashScope → API Key
DASHSCOPE_API_KEY=

# Wan 单价(美元/秒)
DASHSCOPE_PRICE_PER_SECOND=0.05

# 阿里云百炼(Model Studio)业务空间专属域名 — HappyHorse 1.1 / Wan 2.7 视频生成
# (hevi/video/alibaba_maas_service.py)。跟上面的 DASHSCOPE_API_KEY 是同一个阿里云
# 账号体系,但这是"业务空间专属域名"这个独立功能——每个 Model Studio 工作空间给
# 一个专属 host,不是公共 dashscope.aliyuncs.com。
# 提供方: 阿里云百炼控制台 → API-KEY 管理 → 下载业务空间凭证 CSV(含 apiKey/apiHost)
ALIBABA_MAAS_API_KEY=
ALIBABA_MAAS_HOST=

# Vidu API — HEVI-EXEC-01 视频生成主通道 (Reference-to-Video)
# 提供方: Vidu 官网控制台 → API Key
VIDU_API_KEY=

# Runway API — 备用图/视频生成通道 (hevi/video/runway_service.py)
# 提供方: Runway 开发者控制台 → API Key
RUNWAY_API_KEY=

# json2video API — tongjian L6 无角色场景底图云端备选 (hevi/image/json2video_scene_service.py)
# 提供方: json2video.com 控制台 → API Key
JSON2VIDEO_API_KEY=

# WaveSpeed AI API — HappyHorse 1.1 / Wan 2.7 文生视频 (hevi/video/wavespeed_service.py)
# 提供方: wavespeed.ai 控制台 → API Key
WAVESPEED_API_KEY=

# AI 算力引擎(services/gen_engine, 演进自 Voicebox sidecar) —— GPU 权重宿主持有
# 权重先按 docs/VOICEBOX-INTEGRATION.md 下载到 .voicebox-cache
# 预置音色可选 Dylan/Uncle_Fu/Serena；自定义克隆音色填 Voicebox profile id。
GEN_ENGINE_BASE_URL=http://hevi-gen-engine:17493
VOICEBOX_PRESET_VOICE=Dylan
VOICEBOX_PROFILE_ID=
VOICEBOX_ENGINE=qwen_custom_voice
VOICEBOX_MODEL_SIZE=1.7B
VOICEBOX_INSTRUCT=自然、沉稳、有呼吸感的中文纪录片解说，语气有轻微起伏，不要播音腔，不要机械停顿。
# 生产 Compose 默认让解说、通鉴和短剧通鉴都走 AI 引擎的 Voicebox 通道。
HEVI_EXPLAINER_TTS_PROVIDER=voicebox
HEVI_AUDIO_PROVIDER=voicebox
# AI 引擎不可用时是否允许旧 edge_tts 降级(0=失败原因可见,1=继续出片)
VOICEBOX_ALLOW_EDGE_FALLBACK=0
# CosyVoice 解说 / LongCat 数字人权重路径(挂载进引擎, 缺失时端点 501, API 自动降级)
COSYVOICE_MODEL_DIR=/opt/cosyvoice/model
# Fun-CosyVoice3-0.5B(多语言, 含韩/日/英等 9 语; 需宿主机先下载到
# /home/soffy/models/CosyVoice3, 见 docs/VOICEBOX-INTEGRATION.md)
COSYVOICE3_MODEL_DIR=/opt/cosyvoice/fun3
# F5-TTS 零样本音色克隆(引擎侧 /api/ai/f5_tts; 宿主机下载见
# docs/VOICEBOX-INTEGRATION.md)。HEVI_TTS_FORMAL_PROVIDER=f5 时需配下面
# F5_TTS_REFERENCE_AUDIO/TEXT 作为固定解说音色。
F5_TTS_MODEL_DIR=/models/f5-tts
F5_TTS_REFERENCE_AUDIO=
F5_TTS_REFERENCE_TEXT=
# 正式解说合成后端: cosyvoice | f5 | voicebox | edge_tts
HEVI_TTS_FORMAL_PROVIDER=cosyvoice
FISH_SPEECH_MODEL_DIR=/home/soffy/models/fish-speech-1.5
LONGCAT_MODEL_DIR=/data/models/LongCat-Voice

# 旧多说话人 VibeVoice 仍供显式角色克隆链路使用
VIBEVOICE_MODEL_PATH=

# Duix Digital Avatar — Docker 服务地址
# 部署文档: docs/E2E_SETUP.md#duix
# 示例: http://localhost:8088
DUIX_SERVICE_URL=
# Duix health endpoint and real WebRTC/RTMP session endpoint. The latter must
# return both session_id and stream_url; without it HEVI leaves live disabled.
DUIX_HEALTH_PATH=/health
DUIX_LIVESTREAM_PATH=

# Licensed Pexels material search. Results retain source and licence snapshots.
PEXELS_API_KEY=

# B5 可编程供应商插件: 能力声明文件目录(JSON/YAML, 外部可编辑, mtime 即时生效)。
# 空 = 不启用。目录下每个 *.yaml/*.yml/*.json 声明一组 provider 能力/评分。
PROVIDER_PLUGIN_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# === F3 上线 (OAuth / 支付 / 域名) ==========================================
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth 2.0 — 用户登录
# 提供方: Google Cloud Console → API & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# JWT 签名密钥 — 生成: openssl rand -hex 32
JWT_SECRET=

# Paddle 支付 — 订阅扣费
# 提供方: Paddle 控制台 → Developer Tools → API Keys
PADDLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# === 通用配置 ================================================================
# ─────────────────────────────────────────────────────────────────────────────

# 成本熔断上限(美元/任务) — P10.E3 circuit breaker
# 超过此金额的任务将被拒绝执行
COST_LIMIT_PER_TASK_USD=50

# JWT 密钥 — 必填,生成: openssl rand -hex 32 (留空则服务启动即退出)
JWT_SECRET=

# Paddle 支付 (SaaS-4)
# PADDLE_WEBHOOK_SECRET 留空时 webhook 验签 fail-closed(拒绝所有 webhook)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox

# 日志级别: debug / info / warning / error
LOG_LEVEL=info

# 允许的 CORS 来源(逗号分隔),生产环境必须收紧为具体域名。
# 注意: 设为 * 时浏览器禁止携带凭证,后端会自动关闭 allow_credentials。
# 本地开发示例: http://localhost:3000  生产示例: https://app.hevi.io
CORS_ORIGINS=http://localhost:3000

# ── v9.1 OpenCode LLM(OpenAI 兼容, 替换 NIM 作为研究/创意默认) ────────────
# 未配置 OPENCODE_API_KEY 时自动回落 NIM/default(替换可逆)。
OPENCODE_BASE_URL=https://api.opencode.ai/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=hy3
OPENCODE_TIMEOUT_S=600

# ─────────────────────────────────────────────────────────────────────────────
# === h3_local: MiniMax H3 本地视频 provider(ComfyUI,8GB)+ 后处理 ============
# 模块: hevi/providers/h3_local · hevi/post · hevi/prompt/h3_compiler
# 模型栈: H3 W4A8(w4a8_mixed)+ Qwen3-VL Q2_K GGUF + FP16 视频 VAE + FP32 音频 VAE
# 纪律: 8GB 串行、先超分后插帧、对白轨优先 H3 原生音、post 失败降级交付 raw
# ─────────────────────────────────────────────────────────────────────────────

# 数字人 talking-face:echomimic(默认)| duix | longcat | generic | placeholder
# Echo 与 Duix 互斥;同卡不要两套同时开。Echo 与 H3 互斥同 8188,Comfy 必须 start-echomimic.sh。
TALKING_FACE_ENGINE=echomimic
# Duix 离线口型容器(用完即停,避免占 3080)
DUIX_CONTAINER=duix-avatar-gen-video
DUIX_OFFLINE_HEALTH_URL=http://127.0.0.1:8383/easy/query?code=ping
DUIX_STOP_AFTER=1
# 容器内覆盖:http://host.docker.internal:8188(见 docker-compose-cftunnel.yml)
ECHO_MIMIC_COMFY_URL=http://127.0.0.1:8188

# ComfyUI 服务地址(本机默认;启动必须用 /home/soffy/ComfyUI/start-h3.sh,
# 即 --lowvram --reserve-vram 5 + expandable_segments——裸启动在 Q2_K clip 阶段 OOM)
H3_COMFY_URL=http://127.0.0.1:8188
# H3 工作流模板(hevi/providers/h3_local/workflows/ 下,API 格式 + __占位符__)
H3_WORKFLOW=h3_w4a8_zh.json
# 串行队列:1 = 一次只跑一个生成任务(8GB 纪律,与现网 --reserve-vram 1.5 一致)
H3_SERIAL=1
# 单镜超时(秒);W4A8 在 8GB 卡上 5~8s 单镜可达十几分钟
H3_SHOT_TIMEOUT_S=1800
# 模型文件名(与 ComfyUI models/ 目录对应;模板里 __UNET_GGUF__ 等占位符的默认值)
H3_UNET_GGUF=minimax_h3_fl2va_pruned_w4a8_mixed.safetensors
H3_CLIP_GGUF=qwen3vl-32B-MiniMax-H3-Q2_K.gguf
H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# 路由:auto(默认,economy/中文对白镜优先 h3_local)| on | off(矩阵里可关可降级)
H3_ROUTING=auto

# === manim: 代码即画面 (ManimCE 默认; ManimGL 可选) ========================
# 模块: hevi/providers/manim · hevi/prompt/manim_compiler · hevi/explainer/manim_scene
# 不装进 API 镜像。本机有 `manim`/`manimgl` 就走真内核;没有则 ffmpeg 逐帧回退。
# pip 安装社区版: pip install manim   (系统还需 ffmpeg + libcairo2 + libpango)
# 3b1b 原版:     pip install manimgl  (还需 OpenGL;容器里别默认开)
MANIM_BIN=
MANIM_ENGINE=ce
MANIM_TIMEOUT_S=180
MANIM_QUALITY=high
# 1=用 MathTex/Tex(需本机 LaTeX);默认 0 用 Text,共享宿主机更稳
MANIM_USE_MATHTEX=0

# 镜头级后处理(进 ffmpeg 装配之前)
POST_UPSCALE=flashvsr        # off | flashvsr
POST_INTERP=rife2x           # off | rife2x | flowframes
# FlashVSR 工作流模板(hevi/post/workflows/ 下;节点包 1038lab/ComfyUI-FlashVSR,
# 模型自动下载到 ComfyUI/models/FlashVSR/,约 6.7GB)
POST_FLASHVSR_WORKFLOW=flashvsr_2x.json
# RIFE 引擎:auto(优先 ComfyUI 核心 VFI,其次 vspipe,再 flowframes)| comfy_vfi | vspipe | flowframes
POST_RIFE_ENGINE=auto
# comfy_vfi 引擎的插帧模型(放 ComfyUI/models/frame_interpolation/,如 rife49.pth)
POST_RIFE_MODEL=rife49.pth
# vspipe 方案 B 的 core.rife.RIFE 参数(JSON;如 {"model": "4.25", "sc": true})
POST_RIFE_KWARGS=
POST_FLOWFRAMES_EXE=
