# HEVI Frontend Environment Template
#
# Copy this file to .env.local for local development.
# Never commit .env.local with secrets.

# ── Mock Mode ──────────────────────────────────────────
# Mock mode is OFF by default. Set to "true" to enable mock data fallback
# in development (NOT recommended for production verification).
NEXT_PUBLIC_USE_MOCK=false

# ── API Configuration ──────────────────────────────────
# Build environment is explicit. Demo/staging builds must also provide their
# own NEXT_PUBLIC_API_BASE; they never inherit the production origin.
NEXT_PUBLIC_DEPLOY_ENV=development
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Production artifact (set in the production build environment):
# NEXT_PUBLIC_DEPLOY_ENV=production
# NEXT_PUBLIC_API_BASE=https://api-prod.sxueji.com

# Demo/staging artifacts (set independently in their secret/config mechanism):
# NEXT_PUBLIC_DEPLOY_ENV=demo
# NEXT_PUBLIC_API_BASE=https://api-demo.sxueji.com
# NEXT_PUBLIC_DEPLOY_ENV=staging
# NEXT_PUBLIC_API_BASE=https://api-staging.sxueji.com

# Or use Next.js same-origin proxy via /api rewrite:
# (see next.config.ts for proxy rules)
# NEXT_PUBLIC_API_BASE=

# Server-side: internal backend URL (used by Next.js proxy)
# For local dev:
HEVI_BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# For Docker Compose (where "api" is the backend service hostname):
# HEVI_BACKEND_INTERNAL_URL=http://api:8000

# ── CORS (Backend side) ───────────────────────────────
# Configure backend CORS origins for your frontend domain:
# HEVI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
