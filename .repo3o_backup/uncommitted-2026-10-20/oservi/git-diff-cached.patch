+def test_health_reports_counts():
+    engine = _make_engine(steps=[step_ok, step_ok], compensations=[comp_a])
+    h = engine.health()
+    assert h["details"]["steps_count"] == 2
+    assert h["details"]["compensations_count"] == 1
