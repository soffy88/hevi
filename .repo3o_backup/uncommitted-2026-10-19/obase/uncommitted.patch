+def _cosine_distance(a: list[float], b: list[float]) -> float:
+    """1 - cos(a,b)；零向量按最远距离处理。"""
+    dot = sum(x * y for x, y in zip(a, b, strict=False))
+    na = math.sqrt(sum(x * x for x in a))
+    nb = math.sqrt(sum(x * x for x in b))
+    if na == 0 or nb == 0:
+        return 1.0
+    return 1.0 - dot / (na * nb)
+
