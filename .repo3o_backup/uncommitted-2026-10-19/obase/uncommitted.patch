+
+    def _search_sync(
+        self, vector: list[float], top_k: int
+    ) -> list[tuple[MemoryChunk, float]]:
+        with self._connect() as conn:
+            rows = conn.execute(
+                "SELECT * FROM memory_chunk WHERE embedding IS NOT NULL"
+            ).fetchall()
+        scored: list[tuple[MemoryChunk, float]] = []
