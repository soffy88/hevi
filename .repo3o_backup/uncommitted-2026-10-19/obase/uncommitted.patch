+                        content=row["content"],
+                        embedding=emb,
+                        metadata=json.loads(row["metadata"]),
+                        path=row["path"],
+                        created_at=row["created_at"],
+                    ),
+                    dist,
+                )
+            )
+        scored.sort(key=lambda t: t[1])
+        return scored[:top_k]
