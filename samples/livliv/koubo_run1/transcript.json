    {
      "start": 0.0,
      "end": 3.52,
      "text": "大家好,我是LivLiv2.5维角色演示",
      "func": "viewpoint"
    },
    {
      "start": 4.020000000000001,
      "end": 8.64,
      "text": "今天用一段中文口播,测试口型同步和表情表演",
      "func": "viewpoint"
    },
    {
      "start": 9.120000000000001,
      "end": 11.88,
      "text": "第一,口型应该跟着声音开合",
      "func": "viewpoint"
    },
    {
      "start": 12.400000000000002,
      "end": 15.46,
      "text": "第二,句子重音处会有点头动作",
      "func": "viewpoint"
    },
    {
      "start": 15.98,
      "end": 18.94,
      "text": "第三,角色会自然眨眼和呼吸",
      "func": "viewpoint"
    },
    {
      "start": 19.46,
      "end": 22.6,
      "text": "谢谢观看,希望大家喜欢这次演示",
      "func": "viewpoint"
    },
    {
      "start": 23.040000000000003,
      "end": 27.58,
      "text": "如果声音停顿,嘴巴就会闭上,画面也会保持自然",
      "func": "viewpoint"
    },
    {
      "start": 28.0,
      "end": 31.7,
      "text": "我们下一段继续测试第二个角色的口播效果",
      "func": "viewpoint"
    }
