+"""oprim.ffmpeg_probe — Media metadata extraction via ffprobe.
+
+Semantic unit: read-only ffprobe invocation.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from pathlib import Path
+
+
+class FFmpegProbeError(Exception):
+    """FFmpeg probe operation failed."""
+
+
+async def ffmpeg_probe(path: Path) -> dict:
+    """Run ffprobe and return full JSON metadata.
+
+    Args:
+        path: Media file path.
+
+    Returns:
+        Parsed ffprobe JSON output.
+
+    Raises:
+        FFmpegProbeError: ffprobe not found or failed.
+    """
+    if not path.exists():
+        raise FFmpegProbeError(f"File not found: {path}")
+
+    cmd = [
+        "ffprobe", "-v", "quiet",
+        "-print_format", "json",
+        "-show_format", "-show_streams",
+        str(path),
+    ]
+
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+        stdout, stderr = await proc.communicate()
+    except FileNotFoundError as exc:
+        raise FFmpegProbeError("ffprobe not found on PATH") from exc
+
+    if proc.returncode != 0:
+        raise FFmpegProbeError(f"ffprobe failed: {stderr.decode(errors='replace')}")
+
+    try:
+        return json.loads(stdout.decode())
+    except json.JSONDecodeError as exc:
+        raise FFmpegProbeError(f"Failed to parse ffprobe JSON: {exc}") from exc
+
+
+async def ffmpeg_probe_duration(path: Path) -> float:
+    """Get media duration in seconds via ffprobe.
+
+    Args:
+        path: Media file path.
+
+    Returns:
+        Duration in seconds.
+
+    Raises:
+        FFmpegProbeError: ffprobe failed or duration not parseable.
+    """
+    if not path.exists():
+        raise FFmpegProbeError(f"File not found: {path}")
+
+    cmd = [
+        "ffprobe", "-v", "error",
+        "-show_entries", "format=duration",
+        "-of", "default=noprint_wrappers=1:nokey=1",
+        str(path),
+    ]
+
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+        stdout, stderr = await proc.communicate()
+    except FileNotFoundError as exc:
+        raise FFmpegProbeError("ffprobe not found on PATH") from exc
+
+    if proc.returncode != 0:
+        raise FFmpegProbeError(f"ffprobe failed: {stderr.decode(errors='replace')}")
+
+    try:
+        return float(stdout.decode().strip())
+    except ValueError as exc:
+        raise FFmpegProbeError(f"Unparsable duration: {stdout!r}") from exc
+
+
+async def ffmpeg_probe_resolution(path: Path) -> tuple[int, int] | None:
+    """Get video resolution (width, height) via ffprobe.
+
+    Args:
+        path: Media file path.
+
+    Returns:
+        (width, height) or None if no video stream.
+    """
+    meta = await ffmpeg_probe(path)
+    for stream in meta.get("streams", []):
+        if stream.get("codec_type") == "video":
+            w = stream.get("width")
+            h = stream.get("height")
+            if w and h:
+                return (int(w), int(h))
+    return None
+
+
+async def ffmpeg_probe_fps(path: Path) -> float | None:
+    """Get video frame rate via ffprobe.
+
+    Args:
+        path: Media file path.
+
+    Returns:
+        FPS as float, or None if not available.
+    """
+    meta = await ffmpeg_probe(path)
+    for stream in meta.get("streams", []):
+        if stream.get("codec_type") == "video":
+            r = stream.get("r_frame_rate") or stream.get("avg_frame_rate")
+            if r and "/" in r:
+                num, den = r.split("/")
+                try:
+                    return float(num) / float(den)
+                except (ValueError, ZeroDivisionError):
+                    pass
+    return None
+
+
+async def ffmpeg_has_audio(path: Path) -> bool:
+    """Check if media file has audio stream."""
+    meta = await ffmpeg_probe(path)
+    return any(s.get("codec_type") == "audio" for s in meta.get("streams", []))
+
+
+__all__ = [
+    "ffmpeg_probe",
+    "ffmpeg_probe_duration",
+    "ffmpeg_probe_resolution",
+    "ffmpeg_probe_fps",
+    "ffmpeg_has_audio",
+    "FFmpegProbeError",
+]
