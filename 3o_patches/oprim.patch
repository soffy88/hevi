+"""oprim.ffmpeg_mux_audio — Mux video + audio with filter_complex in single ffmpeg call.
+
+Semantic unit: video + audio mixing (amix, sidechain, loudnorm) + mux in ONE call.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from obase.ffmpeg import FFmpegError
+from obase.ffmpeg import run as ffmpeg_run
+
+
+class FFmpegMuxAudioError(Exception):
+    """FFmpeg audio mux operation failed."""
+
+
+async def ffmpeg_mux_audio(
+    video_path: Path,
+    audio_path: Path,
+    *,
+    output_path: Path,
+    filter_complex: str,
+    timeout_s: float = 300.0,
+    copy_video: bool = True,
+    audio_codec: str = "aac",
+    audio_bitrate: str = "192k",
+) -> Path:
+    """Mux video with processed audio using single ffmpeg invocation.
+
+    Args:
+        video_path: Input video file (video stream source).
+        audio_path: Input audio file (narration/BGM/SFX).
+        output_path: Destination file.
+        filter_complex: FFmpeg filter_complex for audio processing
+                        (e.g., loudnorm + sidechain + amix).
+        timeout_s: FFmpeg timeout in seconds.
+        copy_video: If True, copy video stream (-c:v copy); else re-encode.
+        audio_codec: Audio codec for output.
+        audio_bitrate: Audio bitrate for output.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        FFmpegMuxAudioError: On validation failure or FFmpeg error.
+    """
+    for p in (video_path, audio_path):
+        if not p.exists():
+            raise FFmpegMuxAudioError(f"Input file not found: {p}")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    args = [
+        "-y",
+        "-i", str(video_path),
+        "-i", str(audio_path),
+        "-filter_complex", filter_complex,
+        "-map", "0:v",
+        "-map", "[aout]",
+    ]
+
+    if copy_video:
+        args.extend(["-c:v", "copy"])
+    else:
+        args.extend(["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p"])
+
+    args.extend(["-c:a", audio_codec, "-b:a", audio_bitrate, "-shortest", str(output_path)])
+
+    try:
+        await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+    except FFmpegError as exc:
+        raise FFmpegMuxAudioError(f"FFmpeg mux audio failed: {exc}") from exc
+
+    return output_path
+
+
+async def build_loudnorm_filter(
+    narration_idx: int,
+    bgm_idx: int | None = None,
+    sfx_idx: int | None = None,
+    target_lufs: float = -14.0,
+    bgm_gain_db: float = -18.0,
+    sfx_gain_db: float = -6.0,
+    total_duration_s: float = 0.0,
+) -> tuple[str, str]:
+    """Build filter_complex for narration loudnorm + BGM ducking + SFX mix.
+
+    Returns:
+        (filter_complex_string, audio_output_label)
+    """
+    parts: list[str] = []
+    mix_inputs: list[str] = []
+
+    # Narration: loudnorm + apad to total duration
+    parts.append(
+        f"[{narration_idx}:a]loudnorm=I={target_lufs}:TP=-1.5:LRA=11,"
+        f"apad=whole_dur={max(total_duration_s, 0.1):.3f}[narrp]"
+    )
+    mix_inputs.append("[narrp]")
+
+    # BGM: gain + sidechain ducking against narration
+    if bgm_idx is not None:
+        parts.append(f"[{bgm_idx}:a]volume={bgm_gain_db}dB[bgmv]")
+        parts.append(
+            "[bgmv][narrp]sidechaincompress=threshold=0.03:ratio=8:"
+            "attack=20:release=300[bgmduck]"
+        )
+        mix_inputs.append("[bgmduck]")
+
+    # SFX: fixed gain
+    if sfx_idx is not None:
+        parts.append(f"[{sfx_idx}:a]volume={sfx_gain_db}dB[sfxv]")
+        mix_inputs.append("[sfxv]")
+
+    # Final amix
+    n = len(mix_inputs)
+    aout_label = "[aout]"
+    parts.append("".join(mix_inputs) + f"amix=inputs={n}:duration=longest:dropout_transition=2{aout_label}")
+
+    return ";".join(parts), aout_label
+
+
+async def build_narration_only_filter(
+    narration_idx: int,
+    target_lufs: float = -14.0,
+    total_duration_s: float = 0.0,
+) -> tuple[str, str]:
+    """Build filter_complex for narration-only (loudnorm + apad)."""
+    filter_str = (
+        f"[{narration_idx}:a]loudnorm=I={target_lufs}:TP=-1.5:LRA=11,"
+        f"apad=whole_dur={max(total_duration_s, 0.1):.3f}[aout]"
+    )
+    return filter_str, "[aout]"
+
+
+async def build_bgm_only_filter(
+    bgm_idx: int,
+    bgm_gain_db: float = -18.0,
+    total_duration_s: float = 0.0,
+) -> tuple[str, str]:
+    """Build filter_complex for BGM-only (gain + fade out)."""
+    fade_start = max(0.0, total_duration_s - 2.0)
+    filter_str = (
+        f"[{bgm_idx}:a]volume={bgm_gain_db}dB,"
+        f"afade=t=out:st={fade_start:.2f}:d=2[aout]"
+    )
+    return filter_str, "[aout]"
+
+
+__all__ = [
+    "ffmpeg_mux_audio",
+    "FFmpegMuxAudioError",
+    "build_loudnorm_filter",
+    "build_narration_only_filter",
+    "build_bgm_only_filter",
+]
