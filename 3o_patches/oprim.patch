+    style_spec: dict | None = None,
+    timeout_s: float = 300.0,
+    crf: int = 20,
+    preset: str = "veryfast",
+    pix_fmt: str = "yuv420p",
+) -> Path:
+    """Burn subtitles into video with single ffmpeg invocation.
+
+    Args:
+        video_path: Input video file.
