+"""oprim.ffmpeg_extract_cover — Extract single frame as cover image.
+
+Semantic unit: single ffmpeg frame extraction.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from obase.ffmpeg import FFmpegError
+from obase.ffmpeg import run as ffmpeg_run
+
+
+class FFmpegExtractCoverError(Exception):
+    """FFmpeg cover extraction failed."""
+
+
+async def ffmpeg_extract_cover(
+    video_path: Path,
+    output_path: Path,
+    *,
+    timestamp: float = 0.0,
+    timeout_s: float = 60.0,
+) -> Path:
+    """Extract a single frame from video as cover image.
+
+    Args:
+        video_path: Input video file.
+        output_path: Destination image file (JPG/PNG).
+        timestamp: Timestamp in seconds to extract frame from.
+        timeout_s: FFmpeg timeout in seconds.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        FFmpegExtractCoverError: On validation failure or FFmpeg error.
+    """
+    if not video_path.exists():
+        raise FFmpegExtractCoverError(f"Video file not found: {video_path}")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    args = [
+        "-y",
+        "-ss", f"{timestamp:.3f}",
+        "-i", str(video_path),
+        "-frames:v", "1",
+        "-q:v", "2",
+        str(output_path),
+    ]
+
+    try:
+        await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+    except FFmpegError as exc:
+        raise FFmpegExtractCoverError(f"FFmpeg extract cover failed: {exc}") from exc
+
+    return output_path
+
+
+__all__ = ["ffmpeg_extract_cover", "FFmpegExtractCoverError"]
