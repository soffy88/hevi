+"""oprim.ffmpeg_encode — Transcode video to target spec in single ffmpeg call.
+
+Semantic unit: scale/pad/fps/normalize + encode in ONE call.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from obase.ffmpeg import FFmpegError
+from obase.ffmpeg import run as ffmpeg_run
+
+
+class FFmpegEncodeError(Exception):
+    """FFmpeg encode operation failed."""
+
+
+async def ffmpeg_encode(
+    input_path: Path,
+    *,
+    output_path: Path,
+    vf: str,
+    crf: int = 20,
+    preset: str = "veryfast",
+    pix_fmt: str = "yuv420p",
+    timeout_s: float = 300.0,
+    an: bool = False,
+    audio_codec: str = "aac",
+    audio_bitrate: str = "192k",
+) -> Path:
+    """Transcode video to unified spec with single ffmpeg invocation.
+
+    Args:
+        input_path: Input video file.
+        output_path: Destination file.
+        vf: Video filter string (scale, pad, setsar, fps, eq brightness, etc.).
+        crf: Constant rate factor.
+        preset: Encoder preset.
+        pix_fmt: Pixel format.
+        timeout_s: FFmpeg timeout in seconds.
+        an: If True, strip audio (-an).
+        audio_codec: Audio codec if not stripping audio.
+        audio_bitrate: Audio bitrate.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        FFmpegEncodeError: On validation failure or FFmpeg error.
+    """
+    if not input_path.exists():
+        raise FFmpegEncodeError(f"Input file not found: {input_path}")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    args = [
+        "-y",
+        "-i", str(input_path),
+        "-vf", vf,
+        "-c:v", "libx264",
+        "-preset", preset,
+        "-crf", str(crf),
+        "-pix_fmt", pix_fmt,
+    ]
+
+    if an:
+        args.append("-an")
+    else:
+        args.extend(["-c:a", audio_codec, "-b:a", audio_bitrate])
+
+    args.append(str(output_path))
+
+    try:
+        await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+    except FFmpegError as exc:
+        raise FFmpegEncodeError(f"FFmpeg encode failed: {exc}") from exc
+
+    return output_path
+
+
+async def build_normalize_vf(
+    width: int,
+    height: int,
+    fps: int,
+    *,
+    brightness: float = 0.0,
+    force_sar: bool = True,
+) -> str:
+    """Build standard normalization vf string: scale + pad + setsar + fps + optional eq."""
+    vf = (
+        f"scale={width}:{height}:force_original_aspect_ratio=decrease,"
+        f"pad={width}:{height}:(ow-iw)/2:(oh-ih)/2"
+    )
+    if force_sar:
+        vf += ",setsar=1"
+    vf += f",fps={fps}"
+    if brightness:
+        vf += f",eq=brightness={brightness:.4f}"
+    return vf
+
+
+async def measure_avg_luma(path: Path) -> float | None:
+    """Measure average luma of video middle frame (0-255). Returns None on failure."""
+    import subprocess
+    import tempfile
+    from PIL import Image
+
+    try:
+        dur_out = subprocess.run(
+            [
+                "ffprobe", "-v", "error",
+                "-show_entries", "format=duration",
+                "-of", "default=noprint_wrappers=1:nokey=1",
+                str(path),
+            ],
+            capture_output=True, text=True, check=True,
+        )
+        dur = float(dur_out.stdout.strip())
+    except (subprocess.CalledProcessError, ValueError):
+        return None
+
+    with tempfile.TemporaryDirectory(prefix="luma_") as td:
+        frame = Path(td) / "f.png"
+        subprocess.run(
+            [
+                "ffmpeg", "-y",
+                "-ss", f"{dur / 2:.3f}",
+                "-i", str(path),
+                "-frames:v", "1", "-q:v", "3",
+                str(frame),
+            ],
+            capture_output=True,
+        )
+        if not frame.exists():
+            return None
+        with Image.open(frame) as im:
+            hist = im.convert("L").histogram()
+            total = sum(hist)
+            if total == 0:
+                return None
+            return sum(i * c for i, c in enumerate(hist)) / total
+
+
+async def compute_brightness_correction(
+    luma: float,
+    target_luma: float,
+    *,
+    max_delta: float = 0.15,
+) -> float:
+    """Convert luma difference to ffmpeg eq brightness parameter [-1, 1]."""
+    diff = (target_luma - luma) / 255.0
+    return max(-max_delta, min(max_delta, diff))
+
+
+__all__ = [
+    "ffmpeg_encode",
+    "FFmpegEncodeError",
+    "build_normalize_vf",
+    "measure_avg_luma",
+    "compute_brightness_correction",
+]
