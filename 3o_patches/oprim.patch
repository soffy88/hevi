+"""oprim.blender_render_headless — Headless Blender script execution.
+
+Single atomic operation: execute a Blender Python script in headless mode
+and produce MP4 or PNG sequence output.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import shutil
+import tempfile
+from pathlib import Path
+
+
+class BlenderRenderError(Exception):
+    """Headless Blender render failed."""
+
+
+async def blender_render_headless(
+    script_path: Path,
+    *,
+    output_path: Path,
+    fps: int = 24,
+    resolution: tuple[int, int] = (1080, 1920),
+    engine: str = "BLENDER_WORKBENCH",
+    xvfb: bool = True,
+    timeout_s: float = 600.0,
+) -> Path:
+    """Execute a Blender Python script headless and produce video output.
+
+    Args:
+        script_path: Path to .py script containing Blender bpy operations.
+        output_path: Destination file path (MP4 or PNG sequence directory).
+        fps: Output frame rate.
+        resolution: (width, height) in pixels.
+        engine: Blender render engine (BLENDER_WORKBENCH, BLENDER_EEVEE, CYCLES).
+        xvfb: Use Xvfb virtual framebuffer (required for headless GPU rendering).
+        timeout_s: Hard timeout for the render process.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        BlenderRenderError: Blender not found, script error, or output not produced.
+    """
+    blender_bin = shutil.which("blender")
+    if blender_bin is None:
+        raise BlenderRenderError("blender binary not found on PATH")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    width, height = resolution
+    script_content = script_path.read_text(encoding="utf-8")
+
+    # Inject render settings into script
+    render_setup = f"""
+import bpy
+bpy.context.scene.render.fps = {fps}
+bpy.context.scene.render.resolution_x = {width}
+bpy.context.scene.render.resolution_y = {height}
+bpy.context.scene.render.engine = '{engine}'
+bpy.context.scene.render.filepath = '{output_path}'
+bpy.context.scene.render.image_settings.file_format = 'FFMPEG'
+bpy.context.scene.render.ffmpeg.format = 'MPEG4'
+bpy.context.scene.render.ffmpeg.codec = 'H264'
+bpy.context.scene.render.ffmpeg.constant_rate_factor = 'PERC_LOSSLESS'
+"""
+
+    full_script = render_setup + "\n" + script_content
+
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".py", delete=False) as f:
+        f.write(full_script)
+        temp_script = Path(f.name)
+
+    try:
+        cmd = [blender_bin, "-b", "-P", str(temp_script)]
+        if xvfb:
+            xvfb_bin = shutil.which("xvfb-run")
+            if xvfb_bin:
+                cmd = [xvfb_bin, "-a", "--server-args=-screen 0 1920x1080x24", *cmd]
+
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+
+        try:
+            stdout_bytes, stderr_bytes = await asyncio.wait_for(
+                proc.communicate(), timeout=timeout_s
+            )
+        except TimeoutError:
+            proc.kill()
+            await proc.communicate()
+            raise BlenderRenderError(f"Blender render timed out after {timeout_s}s") from None
+
+        stderr_text = stderr_bytes.decode(errors="replace")
+
+        if proc.returncode != 0:
+            raise BlenderRenderError(
+                f"Blender exited with code {proc.returncode}: {stderr_text[-2000:]}"
+            )
+
+        if not output_path.exists():
+            raise BlenderRenderError(f"Blender did not produce output: {output_path}")
+
+        return output_path
+
+    finally:
+        temp_script.unlink(missing_ok=True)
+
+
+__all__ = ["blender_render_headless", "BlenderRenderError"]
