+"""oprim.remotion_render_component — Render single Remotion composition.
+
+Single atomic operation: invoke Remotion CLI to render one composition
+to MP4 with given props and duration.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import shutil
+import tempfile
+from pathlib import Path
+
+
+class RemotionRenderError(Exception):
+    """Remotion render failed."""
+
+
+async def remotion_render_component(
+    component_name: str,
+    *,
+    props: dict,
+    output_path: Path,
+    duration_frames: int,
+    fps: int = 24,
+    remotion_root: Path | None = None,
+    timeout_s: float = 600.0,
+    concurrency: int = 4,
+) -> Path:
+    """Render a single Remotion composition to MP4.
+
+    Args:
+        component_name: Remotion composition ID (e.g., "Explainer-Portrait").
+        props: Props dict passed to the composition.
+        output_path: Destination MP4 file path.
+        duration_frames: Number of frames to render.
+        fps: Frame rate.
+        remotion_root: Path to Remotion project root (package.json location).
+                       If None, uses HEVI_REMOTION_DIR env var or default.
+        timeout_s: Hard timeout for render process.
+        concurrency: Remotion render concurrency.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        RemotionRenderError: Remotion CLI not found, project missing, or render failed.
+    """
+    remotion_cli = shutil.which("remotion")
+    if remotion_cli is None:
+        # Try local node_modules/.bin/remotion
+        if remotion_root:
+            local_cli = remotion_root / "node_modules" / ".bin" / "remotion"
+            if local_cli.exists():
+                remotion_cli = str(local_cli)
+            else:
+                raise RemotionRenderError(
+                    f"Remotion CLI not found at {local_cli}; "
+                    "ensure hevi-remotion dependencies are installed"
+                )
+        else:
+            raise RemotionRenderError("remotion CLI not found on PATH and no remotion_root provided")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    # Determine remotion project root
+    if remotion_root is None:
+        import os
+        remotion_root = Path(os.environ.get("HEVI_REMOTION_DIR", "/app/hevi-remotion"))
+    remotion_root = Path(remotion_root)
+
+    if not (remotion_root / "package.json").exists():
+        raise RemotionRenderError(f"Remotion project not found at {remotion_root}")
+
+    # Write props to manifest file (Remotion reads from src/data/run_manifest.json).
+    # The manifest is a SHARED bundle-time input imported by other compositions.
+    # Only overwrite it when props are supplied, and restore the previous content
+    # after the render so one composition cannot corrupt the project for the next.
+    manifest_path = remotion_root / "src" / "data" / "run_manifest.json"
+    manifest_path.parent.mkdir(parents=True, exist_ok=True)
+    previous_manifest: str | None = None
+    if props:
+        previous_manifest = (
+            manifest_path.read_text(encoding="utf-8") if manifest_path.exists() else None
+        )
+        manifest_path.write_text(
+            json.dumps(props, ensure_ascii=False, indent=2), encoding="utf-8"
+        )
+
+    cmd = [
+        remotion_cli,
+        "render",
+        component_name,
+        str(output_path),
+        f"--concurrency={concurrency}",
+    ]
+
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            cwd=str(remotion_root),
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.STDOUT,
+        )
+
+        try:
+            stdout_bytes, _ = await asyncio.wait_for(proc.communicate(), timeout=timeout_s)
+        except TimeoutError:
+            proc.kill()
+            await proc.communicate()
+            raise RemotionRenderError(f"Remotion render timed out after {timeout_s}s") from None
+    finally:
+        if previous_manifest is not None:
+            manifest_path.write_text(previous_manifest, encoding="utf-8")
+
+    stdout_text = stdout_bytes.decode(errors="replace") if stdout_bytes else ""
+
+    if proc.returncode != 0:
+        raise RemotionRenderError(
+            f"Remotion render failed (exit={proc.returncode}): {stdout_text[-4000:]}"
+        )
+
+    if not output_path.exists() or output_path.stat().st_size == 0:
+        raise RemotionRenderError(f"Remotion did not produce valid output: {output_path}")
+
+    return output_path
+
+
+__all__ = ["remotion_render_component", "RemotionRenderError"]
