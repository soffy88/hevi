+"""oprim.ffmpeg_concat — Concatenate videos with single ffmpeg invocation.
+
+Semantic unit: concat demuxer OR filter_complex concat + re-encode in ONE call.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import tempfile
+from pathlib import Path
+from typing import Literal
+
+from obase.ffmpeg import FFmpegError
+from obase.ffmpeg import run as ffmpeg_run
+
+
+class FFmpegConcatError(Exception):
+    """FFmpeg concat operation failed."""
+
+
+async def ffmpeg_concat(
+    *,
+    inputs: list[Path],
+    output_path: Path,
+    method: Literal["concat_demuxer", "concat_filter"] = "concat_demuxer",
+    timeout_s: float = 600.0,
+    vf: str | None = None,
+    trim_lead_frames: int = 0,
+    transitions: list[dict] | None = None,
+    assumed_fps: float = 30.0,
+) -> Path:
+    """Concatenate multiple video files into one with single ffmpeg call.
+
+    Args:
+        inputs: List of video file paths (≥2 required).
+        output_path: Destination file.
+        method: 'concat_demuxer' (fast, stream copy) or 'concat_filter' (re-encode).
+        timeout_s: FFmpeg timeout in seconds.
+        vf: Video filter string applied to all inputs (e.g., scale/pad/fps normalization).
+        trim_lead_frames: Leading frames to trim from each clip after first.
+        transitions: Optional list of transition specs between clips.
+        assumed_fps: FPS for frame-to-time conversion.
+
+    Returns:
+        The output_path on success.
+
+    Raises:
+        FFmpegConcatError: On validation failure or FFmpeg error.
+    """
+    if len(inputs) < 2:
+        raise FFmpegConcatError("At least 2 input videos required")
+
+    for p in inputs:
+        if not p.exists():
+            raise FFmpegConcatError(f"Input file not found: {p}")
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    if transitions is not None and len(transitions) != len(inputs) - 1:
+        raise FFmpegConcatError(
+            f"transitions length ({len(transitions)}) must equal len(inputs)-1 "
+            f"({len(inputs) - 1})"
+        )
+
+    needs_reencode = vf is not None or trim_lead_frames > 0 or transitions is not None
+    effective_method = "concat_filter" if needs_reencode else method
+
+    # Silent clips (previz / motion-graphic renders) carry no audio stream; the
+    # filter paths must not reference a non-existent [i:a] pad. Probe once and
+    # treat the batch as audio-carrying only when every input has audio.
+    has_audio = all(
+        [await _probe_has_audio(p) for p in inputs]
+    ) if effective_method == "concat_filter" else True
+
+    try:
+        if effective_method == "concat_demuxer":
+            await _concat_demuxer(inputs, output_path, timeout_s)
+        else:
+            await _concat_filter(
+                inputs, output_path, timeout_s,
+                vf=vf,
+                trim_lead_frames=trim_lead_frames,
+                transitions=transitions or [],
+                assumed_fps=assumed_fps,
+                has_audio=has_audio,
+            )
+    except FFmpegError as exc:
+        raise FFmpegConcatError(f"FFmpeg concat failed: {exc}") from exc
+
+    return output_path
+
+
+async def _concat_demuxer(inputs: list[Path], output_path: Path, timeout_s: float) -> None:
+    with tempfile.NamedTemporaryFile(mode="w", suffix=".txt", delete=False) as f:
+        for p in inputs:
+            f.write(f"file '{p.resolve()}'\n")
+        list_path = Path(f.name)
+
+    try:
+        args = [
+            "-f", "concat",
+            "-safe", "0",
+            "-i", str(list_path),
+            "-c", "copy",
+            str(output_path),
+        ]
+        await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+    finally:
+        list_path.unlink(missing_ok=True)
+
+
+_XFADE_KIND = {"dissolve": "fade", "flash": "fadewhite"}
+
+
+async def _concat_filter(
+    inputs: list[Path],
+    output_path: Path,
+    timeout_s: float,
+    vf: str | None,
+    trim_lead_frames: int,
+    transitions: list[dict],
+    assumed_fps: float,
+    has_audio: bool = True,
+) -> None:
+    if transitions:
+        await _concat_with_transitions(
+            inputs, output_path, timeout_s,
+            vf=vf,
+            trim_lead_frames=trim_lead_frames,
+            transitions=transitions,
+            assumed_fps=assumed_fps,
+            has_audio=has_audio,
+        )
+        return
+
+    n = len(inputs)
+    args: list[str] = []
+    for p in inputs:
+        args.extend(["-i", str(p)])
+
+    filter_parts: list[str] = []
+    for i in range(n):
+        v_label = f"[{i}:v]"
+        if i > 0 and trim_lead_frames > 0:
+            filter_parts.append(f"[{i}:v]trim=start_frame={trim_lead_frames}[v{i}t];")
+            v_label = f"[v{i}t]"
+            if has_audio:
+                filter_parts.append(f"[{i}:a]atrim=start={trim_lead_frames / assumed_fps:.4f}[a{i}t];")
+
+        if vf:
+            filter_parts.append(f"{v_label}{vf}[v{i}f];")
+            v_label = f"[v{i}f]"
+
+        if has_audio:
+            a_label = f"[a{i}t]" if (i > 0 and trim_lead_frames > 0) else f"[{i}:a]"
+            filter_parts.append(f"{v_label}{a_label}")
+        else:
+            filter_parts.append(v_label)
+
+    concat_inputs = "".join(filter_parts)
+    if has_audio:
+        filter_complex = f"{concat_inputs}concat=n={n}:v=1:a=1[outv][outa]"
+        maps = ["-map", "[outv]", "-map", "[outa]"]
+    else:
+        filter_complex = f"{concat_inputs}concat=n={n}:v=1:a=0[outv]"
+        maps = ["-map", "[outv]"]
+
+    args.extend([
+        "-filter_complex", filter_complex,
+        *maps,
+        "-c:v", "libx264",
+        "-preset", "veryfast",
+        "-crf", "20",
+        "-pix_fmt", "yuv420p",
+        str(output_path),
+    ])
+    await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+
+
+async def _concat_with_transitions(
+    inputs: list[Path],
+    output_path: Path,
+    timeout_s: float,
+    vf: str | None,
+    trim_lead_frames: int,
+    transitions: list[dict],
+    assumed_fps: float,
+    has_audio: bool = True,
+) -> None:
+    n = len(inputs)
+
+    needs_durations = any(
+        spec.get("type", "hard") != "hard" and float(spec.get("duration_s", 0.0)) > 0.0
+        for spec in transitions
+    )
+    durations = await _probe_durations(inputs) if needs_durations else [0.0] * n
+
+    args: list[str] = []
+    for p in inputs:
+        args.extend(["-i", str(p)])
+
+    parts: list[str] = []
+    base_v: list[str] = []
+    base_a: list[str] = []
+
+    for i in range(n):
+        vf_parts: list[str] = []
+        af_parts: list[str] = []
+        if i > 0 and trim_lead_frames > 0:
+            vf_parts.append(f"trim=start_frame={trim_lead_frames}")
+            af_parts.append(f"atrim=start={trim_lead_frames / assumed_fps:.4f}")
+        if vf:
+            vf_parts.append(vf)
+        # xfade demands a constant frame rate; the fps filter must run after the
+        # PTS reset (fps-then-setpts leaves the rate unset and xfade rejects it).
+        vf_parts.extend(["format=yuv420p", "setpts=PTS-STARTPTS", f"fps={assumed_fps}"])
+        parts.append(f"[{i}:v]{','.join(vf_parts)}[bv{i}];")
+        base_v.append(f"[bv{i}]")
+        if has_audio:
+            af_parts.append("asetpts=PTS-STARTPTS")
+            parts.append(f"[{i}:a]{','.join(af_parts)}[ba{i}];")
+            base_a.append(f"[ba{i}]")
+
+    v_acc = base_v[0]
+    a_acc = base_a[0] if has_audio else ""
+    running = durations[0]
+
+    for i in range(1, n):
+        spec = transitions[i - 1]
+        ttype = spec.get("type", "hard")
+        dur = float(spec.get("duration_s", 0.0))
+        v_out = f"[vc{i}]"
+        a_out = f"[ac{i}]"
+
+        if ttype == "hard" or dur <= 0.0:
+            parts.append(f"{v_acc}{base_v[i]}concat=n=2:v=1:a=0{v_out};")
+            if has_audio:
+                parts.append(f"{a_acc}{base_a[i]}concat=n=2:v=0:a=1{a_out};")
+            running += durations[i]
+        else:
+            kind = _XFADE_KIND.get(ttype, "fade")
+            offset = max(0.0, running - dur)
+            parts.append(
+                f"{v_acc}{base_v[i]}xfade=transition={kind}:duration={dur:.4f}:offset={offset:.4f}{v_out};"
+            )
+            if has_audio:
+                parts.append(f"{a_acc}{base_a[i]}acrossfade=d={dur:.4f}{a_out};")
+            running += durations[i] - dur
+
+        v_acc = v_out
+        if has_audio:
+            a_acc = a_out
+
+    filter_complex = "".join(parts).rstrip(";")
+
+    args.extend([
+        "-filter_complex", filter_complex,
+        "-map", v_acc,
+    ])
+    if has_audio:
+        args.extend(["-map", a_acc])
+    args.extend([
+        "-c:v", "libx264",
+        "-preset", "veryfast",
+        "-crf", "20",
+        "-pix_fmt", "yuv420p",
+        str(output_path),
+    ])
+    await ffmpeg_run(args=args, timeout_s=timeout_s, expected_output=output_path)
+
+
+async def _probe_has_audio(path: Path) -> bool:
+    """Return True when the media file has at least one audio stream."""
+    cmd = [
+        "ffprobe", "-v", "error",
+        "-select_streams", "a",
+        "-show_entries", "stream=codec_type",
+        "-of", "csv=p=0",
+        str(path),
+    ]
+    try:
+        proc = await asyncio.create_subprocess_exec(
+            *cmd,
+            stdout=asyncio.subprocess.PIPE,
+            stderr=asyncio.subprocess.PIPE,
+        )
+        stdout, _ = await proc.communicate()
+    except FileNotFoundError as exc:
+        raise FFmpegConcatError("ffprobe not found on PATH") from exc
+    if proc.returncode != 0:
+        return False
+    return bool(stdout.decode(errors="replace").strip())
+
+
+async def _probe_durations(inputs: list[Path]) -> list[float]:
+    durations: list[float] = []
+    for p in inputs:
+        cmd = [
+            "ffprobe", "-v", "quiet", "-print_format", "json",
+            "-show_format", str(p),
+        ]
+        try:
+            proc = await asyncio.create_subprocess_exec(
+                *cmd,
+                stdout=asyncio.subprocess.PIPE,
+                stderr=asyncio.subprocess.PIPE,
+            )
+            stdout, _ = await proc.communicate()
+        except FileNotFoundError as exc:
+            raise FFmpegConcatError("ffprobe not found on PATH") from exc
+        if proc.returncode != 0:
+            raise FFmpegConcatError(f"ffprobe failed for {p}")
+        try:
+            durations.append(float(json.loads(stdout.decode())["format"]["duration"]))
+        except (KeyError, ValueError) as exc:
+            raise FFmpegConcatError(f"Could not parse duration for {p}") from exc
+    return durations
+
+
+__all__ = ["ffmpeg_concat", "FFmpegConcatError"]
