+"""oprim.v2v_dispatch_infer — Video-to-Video style transfer inference.
+
+Single atomic operation: execute one V2V inference call with reference video
+and prompt, returning stylized output plus motion vectors for drift analysis.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+from typing import Any
+
+from obase import ProviderRegistry
+from obase.exceptions import ProviderNotFoundError
+
+
+class V2VInferError(Exception):
+    """V2V inference failed."""
+
+
+class V2VProviderNotFoundError(Exception):
+    """V2V provider not registered."""
+
+
+async def v2v_dispatch_infer(
+    ref_video_path: Path,
+    *,
+    prompt: str,
+    model_provider: str,
+    output_path: Path,
+    guidance_scale: float = 7.5,
+    timeout_s: float = 600.0,
+    **provider_kwargs: Any,
+) -> dict[str, Any]:
+    """Execute single V2V inference with structure-locked reference video.
+
+    Args:
+        ref_video_path: Path to reference/whitebox video (structure lock).
+        prompt: Text prompt for style transfer.
+        model_provider: Provider name registered in obase.ProviderRegistry
+                        (category='v2v' or 'video_gen' with i2v mode).
+        output_path: Destination MP4 file path.
+        guidance_scale: CFG guidance scale for diffusion models.
+        timeout_s: Hard timeout for inference.
+        **provider_kwargs: Additional provider-specific parameters.
+
+    Returns:
+        Dict with keys:
+            - "output_path": Path to generated video
+            - "ref_motion_vectors": list[list[float]] motion vectors from reference
+            - "out_motion_vectors": list[list[float]] motion vectors from output
+            - "cost_usd": float estimated cost
+            - "provider": str provider name used
+
+    Raises:
+        V2VProviderNotFoundError: Provider not registered.
+        V2VInferError: Inference failed or output not produced.
+    """
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+
+    if not ref_video_path.exists():
+        raise V2VInferError(f"Reference video not found: {ref_video_path}")
+
+    # Try v2v category first, then video_gen with i2v mode
+    provider_fn = None
+    used_category = None
+    used_provider = model_provider
+
+    try:
+        provider_fn = ProviderRegistry.get().generic("v2v", model_provider)
+        used_category = "v2v"
+    except ProviderNotFoundError:
+        try:
+            provider_fn = ProviderRegistry.get().generic("video_gen", model_provider)
+            used_category = "video_gen"
+        except ProviderNotFoundError:
+            pass
+
+    if provider_fn is None:
+        raise V2VProviderNotFoundError(
+            f"V2V provider not found in categories 'v2v' or 'video_gen': {model_provider!r}"
+        )
+
+    # Prepare kwargs for provider call
+    call_kwargs = {
+        "prompt": prompt,
+        "reference_video": ref_video_path,
+        "output_path": output_path,
+        "guidance_scale": guidance_scale,
+        "timeout_s": timeout_s,
+        **provider_kwargs,
+    }
+
+    import asyncio
+
+    try:
+        result = await asyncio.wait_for(provider_fn(**call_kwargs), timeout=timeout_s)
+    except TimeoutError:
+        raise V2VInferError(f"V2V inference timed out after {timeout_s}s") from None
+    except Exception as exc:
+        raise V2VInferError(f"V2V inference failed: {exc}") from exc
+
+    if not output_path.exists():
+        raise V2VInferError(f"Provider did not produce output: {output_path}")
+
+    # Extract motion vectors from result if available
+    # Providers may return them directly or we compute them
+    ref_motion_vectors = result.get("ref_motion_vectors", []) if isinstance(result, dict) else []
+    out_motion_vectors = result.get("out_motion_vectors", []) if isinstance(result, dict) else []
+    cost_usd = result.get("cost_usd", 0.0) if isinstance(result, dict) else 0.0
+
+    return {
+        "output_path": output_path,
+        "ref_motion_vectors": ref_motion_vectors,
+        "out_motion_vectors": out_motion_vectors,
+        "cost_usd": cost_usd,
+        "provider": used_provider,
+        "category": used_category,
+    }
+
+
+__all__ = ["v2v_dispatch_infer", "V2VInferError", "V2VProviderNotFoundError"]
