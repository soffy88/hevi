+"""omodul.remotion_template_render — Single Remotion composition render.
+
+Canonical transaction: composition_id + props → Remotion CLI render → MP4 segment.
+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any, Callable
+
+from omodul._base import BaseConfig
+
+from oprim import file_checksum, remotion_render_component
+
+logger = logging.getLogger(__name__)
+
+
+class RemotionTemplateRenderError(Exception):
+    """Remotion template render failed."""
+
+
+def _report(
+    *,
+    status: str,
+    artifacts: tuple[str, ...] = (),
+    metadata: dict[str, Any] | None = None,
+    error: str | None = None,
+) -> dict[str, Any]:
+    """Return the transaction's report pillar without hidden file IO."""
+    report: dict[str, Any] = {
+        "transaction": "remotion_template_render",
+        "status": status,
+        "artifacts": list(artifacts),
+        "metadata": dict(metadata or {}),
+    }
+    if error is not None:
+        report["error"] = error
+    return report
+
+
+async def remotion_template_render(
+    config: BaseConfig,
+    input_data: dict[str, Any],
+    output_dir: Path,
+    *,
+    on_step: Callable[[dict], None] | None = None,
+) -> dict[str, Any]:
+    """Render single Remotion composition component.
+
+    Args:
+        config: Base configuration.
+        input_data: Must contain:
+            - "composition_id": Remotion composition identifier (e.g., "Explainer-Portrait")
+            - "props": Props dict passed to the composition
+            - "duration_frames": Number of frames to render
+            - "fps": Frame rate (default 24)
+            - "remotion_root": Optional path to Remotion project root
+        output_dir: Output directory for artifacts.
+        on_step: Optional progress callback.
+
+    Returns:
+        Canonical transaction result with:
+        - status: "completed" | "failed"
+        - error: Error dict if failed
+        - _enabled_pillars: ["fingerprint", "decision_trail", "report", "cost"]
+        - result: {"video_path": str, "composition_id": str, "duration_frames": int}
+        - fingerprint: sha256 of output video
+        - cost: USD cost (0.0 for local render)
+    """
+    cost_usd = 0.0
+    decision_trail: dict[str, Any] = {"transaction": "remotion_template_render"}
+    enabled_pillars = {"fingerprint", "decision_trail", "report", "cost"}
+
+    try:
+        # 1. Extract and validate input
+        composition_id = input_data.get("composition_id", "")
+        props = input_data.get("props", {})
+        duration_frames = input_data.get("duration_frames", 72)
+        fps = input_data.get("fps", 24)
+        remotion_root = input_data.get("remotion_root")  # Optional
+
+        if not composition_id:
+            raise RemotionTemplateRenderError("composition_id is required")
+        if not isinstance(props, dict):
+            raise RemotionTemplateRenderError("props must be a dict")
+
+        output_mp4 = output_dir / f"remotion_{composition_id}.mp4"
+
+        if on_step:
+            on_step({"step": "remotion_render", "composition_id": composition_id})
+
+        # 2. Execute Remotion render (oprim: atomic primitive)
+        await remotion_render_component(
+            component_name=composition_id,
+            props=props,
+            output_path=output_dir / f"remotion_{composition_id}.mp4",
+            duration_frames=duration_frames,
+            fps=fps,
+            remotion_root=Path(remotion_root) if remotion_root else None,
+        )
+
+        if not output_mp4.exists():
+            raise RemotionTemplateRenderError("Remotion render produced no output")
+
+        if output_mp4.stat().st_size == 0:
+            raise RemotionTemplateRenderError("Remotion render produced empty output")
+
+        # 3. Fingerprint the produced artifact with the canonical file primitive.
+        fingerprint = file_checksum(file_path=str(output_mp4))
+
+        decision_trail["fingerprint"] = fingerprint
+        decision_trail["composition_id"] = composition_id
+        decision_trail["duration_frames"] = duration_frames
+        decision_trail["fps"] = fps
+
+        return {
+            "status": "completed",
+            "error": None,
+            "_enabled_pillars": ["fingerprint", "decision_trail", "report", "cost"],
+            "result": {
+                "video_path": str(output_mp4),
+                "composition_id": composition_id,
+                "duration_frames": duration_frames,
+                "fps": fps,
+            },
+            "fingerprint": fingerprint,
+            "decision_trail": decision_trail,
+            "cost": 0.0,
+            "report": _report(
+                status="completed",
+                artifacts=(str(output_mp4),),
+                metadata={"composition_id": composition_id, "duration_frames": duration_frames, "fps": fps},
+            ),
+        }
+
+    except Exception as exc:
