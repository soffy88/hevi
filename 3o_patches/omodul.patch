+    ffmpeg_concat,
+    ffmpeg_mux_audio,
+    ffmpeg_burn_subtitles,
+    ffmpeg_encode,
+    ffmpeg_probe_duration,
+    file_checksum,
+    file_write,
+)
+
+logger = logging.getLogger(__name__)
+
+
+class MediaTimelineAssembleError(Exception):
+    """Media timeline assembly failed."""
+
+
+def _report(
+    *,
+    status: str,
+    artifacts: tuple[str, ...] = (),
+    metadata: dict[str, Any] | None = None,
+    error: str | None = None,
+) -> dict[str, Any]:
+    """Return the transaction's report pillar without hidden file IO."""
+    report: dict[str, Any] = {
+        "transaction": "media_timeline_assemble",
+        "status": status,
+        "artifacts": list(artifacts),
+        "metadata": dict(metadata or {}),
+    }
+    if error is not None:
+        report["error"] = error
+    return report
+
+
+async def media_timeline_assemble(
+    config: BaseConfig,
+    input_data: dict[str, Any],
+    output_dir: Path,
+    *,
+    on_step: Callable[[dict], None] | None = None,
+) -> dict[str, Any]:
+    """Assemble final video from shot clips, audio, and subtitles.
+
+    Args:
+        config: Base configuration with QC thresholds.
+        input_data: Must contain:
+            - "shots": List of shot dicts with:
+                - "video_path": Path to shot video
+                - "start_frame": int (optional)
+                - "end_frame": int (optional)
+                - "text": str (for subtitle alignment)
+            - "audio_path": Path to narration audio (optional)
+            - "subtitles_path": Path to SRT/ASS subtitles (optional)
+            - "bgm_path": Path to background music (optional)
+            - "fps": Frame rate (default 24)
+            - "resolution": (width, height) tuple (default 1080x1920)
+            - "transition": Transition type (default "fade")
+            - "transition_duration": float (default 0.5)
+            - "loudness_lufs": Target loudness (default -14.0)
+            - "bgm_gain_db": BGM gain (default -18.0)
+        output_dir: Output directory for artifacts.
+        on_step: Optional progress callback.
+
+    Returns:
+        Canonical transaction result with:
+        - status: "completed" | "failed"
+        - error: Error dict if failed
+        - _enabled_pillars: ["fingerprint", "decision_trail", "report", "cost"]
+        - result: {"video_path": str, "duration_s": float}
+        - fingerprint: sha256 of final video
+        - cost: USD cost (0.0 for local assembly)
+    """
+    cost_usd = 0.0
+    decision_trail: dict[str, Any] = {"transaction": "media_timeline_assemble"}
+    enabled_pillars = {"fingerprint", "decision_trail", "report", "cost"}
+
+    try:
+        # 1. Extract and validate input
+        shots = input_data.get("shots", [])
+        audio_path = Path(input_data.get("audio_path", "")) if input_data.get("audio_path") else None
+        subtitles_path = Path(input_data.get("subtitles_path", "")) if input_data.get("subtitles_path") else None
+        bgm_path = Path(input_data.get("bgm_path", "")) if input_data.get("bgm_path") else None
+
+        fps = input_data.get("fps", 24)
+        resolution = input_data.get("resolution", (1080, 1920))
+        transition = input_data.get("transition", "fade")
+        transition_duration = input_data.get("transition_duration", 0.5)
+        loudness_lufs = input_data.get("loudness_lufs", -14.0)
+        bgm_gain_db = input_data.get("bgm_gain_db", -18.0)
