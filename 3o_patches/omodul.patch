+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any, Callable
+
+from omodul._base import BaseConfig
+
+from oskill.timeline_math import calc_timecode_alignment, calculate_shot_durations
+from oskill.subtitle import cues_to_srt, generate_ass_karaoke
