+"""omodul.previz_guided_v2v_render — V2V stylization with previz structure lock.
+
+Canonical transaction: previz video + prompt → V2V inference → camera drift validation → stylized clip.
+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any, Callable
+
+from omodul._base import BaseConfig
+
+from oprim import file_checksum, v2v_dispatch_infer
+from oskill.quality import compute_camera_drift_score
+
+logger = logging.getLogger(__name__)
+
+
+class PrevizGuidedV2VError(Exception):
+    """Previz-guided V2V render failed."""
+
+
+def _report(
+    *,
+    status: str,
+    artifacts: tuple[str, ...] = (),
+    metadata: dict[str, Any] | None = None,
+    error: str | None = None,
+) -> dict[str, Any]:
+    """Return the transaction's report pillar without hidden file IO."""
+    report: dict[str, Any] = {
+        "transaction": "previz_guided_v2v_render",
+        "status": status,
+        "artifacts": list(artifacts),
+        "metadata": dict(metadata or {}),
+    }
+    if error is not None:
+        report["error"] = error
+    return report
+
+
+async def previz_guided_v2v_render(
+    config: BaseConfig,
+    input_data: dict[str, Any],
+    output_dir: Path,
+    *,
+    on_step: Callable[[dict], None] | None = None,
+) -> dict[str, Any]:
+    """Generate stylized clip from previz with structure lock and drift validation.
+
+    Args:
+        config: Base configuration with max_camera_drift_threshold.
+        input_data: Must contain:
+            - "previz_video_path": Path to whitebox previz video
+            - "prompt": Text prompt for V2V style transfer
+            - "provider": V2V provider name (registered in obase.ProviderRegistry)
+            - "shot_id": Shot identifier for output naming
+            - "guidance_scale": Optional CFG scale (default 7.5)
+        output_dir: Output directory for artifacts.
+        on_step: Optional progress callback.
+
+    Returns:
+        Canonical transaction result with:
+        - status: "completed" | "failed"
+        - error: Error dict if failed
+        - _enabled_pillars: ["fingerprint", "decision_trail", "report", "cost"]
+        - result: {"clip_path": str, "drift_score": float, "provider": str}
+        - fingerprint: sha256 of output video
+        - cost: USD cost from V2V provider
+    """
+    cost_usd = 0.0
+    decision_trail: dict[str, Any] = {"transaction": "previz_guided_v2v_render"}
+    enabled_pillars = {"fingerprint", "decision_trail", "report", "cost"}
+
+    # Drift threshold from config (HEVI Layer4 policy, not baked into transaction)
+    max_drift_threshold = getattr(config, "max_camera_drift_threshold", 0.15)
+
+    try:
+        # 1. Extract and validate input
+        previz_path = Path(input_data.get("previz_video_path", ""))
+        prompt = input_data.get("prompt", "")
+        provider = input_data.get("provider", "")
+        shot_id = input_data.get("shot_id", "001")
+        guidance_scale = input_data.get("guidance_scale", 7.5)
+
+        if not previz_path.exists():
+            raise PrevizGuidedV2VError(f"Previz video not found: {previz_path}")
+        if not prompt:
+            raise PrevizGuidedV2VError("Prompt is required")
+        if not provider:
+            raise PrevizGuidedV2VError("V2V provider is required")
+
+        output_clip = output_dir / f"clip_{shot_id}.mp4"
+
+        if on_step:
+            on_step({"step": "v2v_inference", "shot_id": shot_id, "provider": provider})
+
+        # 2. Execute V2V inference (oprim: atomic primitive)
+        v2v_result = await v2v_dispatch_infer(
+            previz_path,
+            prompt=prompt,
+            model_provider=provider,
+            output_path=output_clip,
+            guidance_scale=guidance_scale,
+        )
+
+        cost_usd = v2v_result.get("cost_usd", 0.0)
+        decision_trail["v2v_provider"] = provider
+        decision_trail["v2v_cost_usd"] = cost_usd
+
+        if on_step:
+            on_step({"step": "drift_validation", "shot_id": shot_id})
+
+        # 3. Camera drift validation (oskill: pure algorithm)
+        ref_vectors = v2v_result.get("ref_motion_vectors", [])
+        out_vectors = v2v_result.get("out_motion_vectors", [])
+
+        if ref_vectors and out_vectors:
+            drift_score = compute_camera_drift_score(ref_vectors, out_vectors)
+            decision_trail["drift_score"] = drift_score
+            decision_trail["drift_threshold"] = max_drift_threshold
+
+            if drift_score > max_drift_threshold:
+                if on_step:
+                    on_step({"step": "drift_exceeded", "shot_id": shot_id, "drift_score": drift_score})
+                return {
+                    "status": "failed",
+                    "error": {
+                        "code": "CAMERA_DRIFT_EXCEEDED",
+                        "message": f"Camera drift {drift_score:.4f} exceeds threshold {max_drift_threshold}",
+                        "retryable": True,
+                    },
+                    "_enabled_pillars": ["decision_trail", "cost"],
+                    "result": None,
+                    "fingerprint": None,
+                    "decision_trail": decision_trail,
+                    "cost": cost_usd,
+                    "report": None,
+                }
+        else:
+            drift_score = 1.0  # No vectors = max drift
+            decision_trail["drift_score"] = drift_score
+            decision_trail["drift_note"] = "motion_vectors_unavailable"
+
+        # 4. Verify output
+        if not output_clip.exists() or output_clip.stat().st_size == 0:
+            raise PrevizGuidedV2VError("V2V inference produced no output")
+
+        # 5. Fingerprint the produced artifact with the canonical file primitive.
+        fingerprint = file_checksum(file_path=str(output_clip))
+        decision_trail["fingerprint"] = fingerprint
+
+        if on_step:
+            on_step({"step": "completed", "shot_id": shot_id, "output": str(output_clip), "drift_score": drift_score})
+
+        return {
+            "status": "completed",
+            "error": None,
+            "_enabled_pillars": list(enabled_pillars),
+            "result": {
+                "clip_path": str(output_clip),
+                "drift_score": drift_score,
+                "provider": provider,
+            },
+            "fingerprint": fingerprint,
+            "decision_trail": decision_trail,
+            "cost": cost_usd,
+            "report": _report(
+                status="completed",
+                artifacts=(str(output_clip),),
+                metadata={"shot_id": shot_id, "provider": provider, "drift_score": drift_score},
+            ),
+        }
+
+    except Exception as exc:
+        logger.exception("previz_guided_v2v_render failed")
+        return {
+            "status": "failed",
+            "error": {"code": "PREVIZ_GUIDED_V2V_FAILED", "message": str(exc), "retryable": True},
+            "_enabled_pillars": ["decision_trail", "cost"],
+            "result": None,
+            "fingerprint": None,
+            "decision_trail": decision_trail | {"error": str(exc)},
+            "cost": cost_usd,
+            "report": _report(status="failed", error=str(exc)),
+        }
+
+
+def compute_fingerprint_for(config: Any, input_data: Any) -> str:
+    """Compute deterministic fingerprint for previz_guided_v2v_render transaction.
+
+    Based on: previz_video hash, prompt, provider, guidance_scale, config version.
+    """
+    import hashlib
+    import json
+
+    previz_path = input_data.get("previz_video_path", "")
+    prompt = input_data.get("prompt", "")
+    provider = input_data.get("provider", "")
+    guidance_scale = input_data.get("guidance_scale", 7.5)
+
+    fingerprint_data = {
+        "transaction": "previz_guided_v2v_render",
+        "previz_path": previz_path,
+        "prompt": prompt,
+        "provider": provider,
+        "guidance_scale": guidance_scale,
+    }
+    content = json.dumps(fingerprint_data, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(content.encode()).hexdigest()[:24]
+
+
+__all__ = ["previz_guided_v2v_render", "PrevizGuidedV2VError", "compute_fingerprint_for"]
