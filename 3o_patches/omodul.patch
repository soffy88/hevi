+"""omodul.previz_generate — Whitebox previz generation from shot spec.
+
+Canonical transaction: shot_spec → deterministic Blender script → headless render → MP4.
+"""
+
+from __future__ import annotations
+
+import logging
+from pathlib import Path
+from typing import Any, Callable
+
+from omodul._base import BaseConfig
+
+from oskill.previz_compiler import build_previz_bpy_script
+from oprim import blender_render_headless, file_checksum, file_delete, file_write
+
+logger = logging.getLogger(__name__)
+
+
+class PrevizGenerateError(Exception):
+    """Previz generation failed."""
+
+
+def _report(
+    *,
+    status: str,
+    artifacts: tuple[str, ...] = (),
+    metadata: dict[str, Any] | None = None,
+    error: str | None = None,
+) -> dict[str, Any]:
+    """Return the transaction's report pillar without hidden file IO."""
+    report: dict[str, Any] = {
+        "transaction": "previz_generate",
+        "status": status,
+        "artifacts": list(artifacts),
+        "metadata": dict(metadata or {}),
+    }
+    if error is not None:
+        report["error"] = error
+    return report
+
+
+async def previz_generate(
+    config: BaseConfig,
+    input_data: dict[str, Any],
+    output_dir: Path,
+    *,
+    on_step: Callable[[dict], None] | None = None,
+) -> dict[str, Any]:
+    """Generate whitebox previz from shot specification.
+
+    Args:
+        config: Base configuration.
+        input_data: Must contain:
+            - "shot_spec": Shot specification dict with shot_id, scene_type, camera_motion, actor_action, duration_s
+            - "fps": Frame rate (default 24)
+            - "resolution": (width, height) tuple (default 1080x1920)
+        output_dir: Output directory for artifacts.
+        on_step: Optional progress callback.
+
+    Returns:
+        Canonical transaction result with:
+        - status: "completed" | "failed"
+        - error: Error dict if failed
+        - _enabled_pillars: ["fingerprint", "decision_trail", "report", "cost"]
+        - result: {"video_path": str, "shot_id": str}
+        - fingerprint: sha256 of output video
+        - cost: USD cost (0.0 for local render)
+    """
+    cost_usd = 0.0
+    decision_trail: dict[str, Any] = {"transaction": "previz_generate"}
+    enabled_pillars = {"fingerprint", "decision_trail", "report", "cost"}
+
+    try:
+        # 1. Extract and validate input
+        shot_spec = input_data.get("shot_spec", {})
+        if not shot_spec:
+            raise PrevizGenerateError("input_data.shot_spec is required")
+
+        shot_id = shot_spec.get("shot_id", "001")
+        fps = input_data.get("fps", 24)
+        resolution = input_data.get("resolution", (1080, 1920))
+
+        output_mp4 = output_dir / f"previz_{shot_id}.mp4"
+
+        if on_step:
+            on_step({"step": "compile_bpy_script", "shot_id": shot_id})
+
+        # 2. Compile deterministic Blender script (oskill: pure algorithm)
+        bpy_script = build_previz_bpy_script(
+            shot_spec,
+            scene_type=shot_spec.get("scene_type", "geometry_block"),
+            camera_motion=shot_spec.get("camera_motion", "dolly_in"),
+            actor_action=shot_spec.get("actor_action", "walk_and_stop"),
+            resolution=resolution,
+            fps=fps,
+            duration_s=shot_spec.get("duration_s", 5.0),
+        )
+
+        # 3. Materialize the compiled script with the canonical file primitive.
+        script_path = output_dir / f"previz_{shot_id}_render.py"
+        file_write(script_path, content=bpy_script)
+
+        decision_trail["bpy_script_compiled"] = True
+        decision_trail["script_path"] = str(script_path)
+
+        if on_step:
+            on_step({"step": "blender_render", "shot_id": shot_id})
+
+        # 4. Execute headless Blender render (oprim: atomic primitive)
+        try:
+            await blender_render_headless(
+                script_path,
+                output_path=output_mp4,
+                fps=fps,
+                resolution=resolution,
+                engine="BLENDER_WORKBENCH",
+            )
+        finally:
+            file_delete(script_path, missing_ok=True)
+
+        if not output_mp4.exists() or output_mp4.stat().st_size == 0:
+            raise PrevizGenerateError("Blender render produced no output")
+
+        # 5. Compute the content fingerprint with the canonical file primitive.
+        fingerprint = file_checksum(file_path=str(output_mp4))
+        decision_trail["fingerprint"] = fingerprint
+
+        if on_step:
+            on_step({"step": "completed", "shot_id": shot_id, "output": str(output_mp4)})
+
+        return {
+            "status": "completed",
+            "error": None,
+            "_enabled_pillars": list(enabled_pillars),
+            "result": {"video_path": str(output_mp4), "shot_id": shot_id},
+            "fingerprint": fingerprint,
+            "decision_trail": decision_trail,
+            "cost": cost_usd,
+            "report": _report(
+                status="completed",
+                artifacts=(str(output_mp4),),
+                metadata={"shot_id": shot_id, "fps": fps, "resolution": resolution},
+            ),
+        }
+
+    except Exception as exc:
+        logger.exception("previz_generate failed")
+        return {
+            "status": "failed",
+            "error": {"code": "PREVIZ_GENERATE_FAILED", "message": str(exc), "retryable": False},
+            "_enabled_pillars": ["decision_trail", "cost"],
+            "result": None,
+            "fingerprint": None,
+            "decision_trail": decision_trail | {"error": str(exc)},
+            "cost": cost_usd,
+            "report": _report(status="failed", error=str(exc)),
+        }
+
+
+def compute_fingerprint_for(config: Any, input_data: Any) -> str:
+    """Compute deterministic fingerprint for previz_generate transaction.
+
+    Based on: shot_spec, fps, resolution, engine, config version.
+    """
+    import hashlib
+    import json
+
+    shot_spec = input_data.get("shot_spec", {})
+    fps = input_data.get("fps", 24)
+    resolution = input_data.get("resolution", (1080, 1920))
+    engine = "BLENDER_WORKBENCH"  # fixed for this transaction
+
+    fingerprint_data = {
+        "transaction": "previz_generate",
+        "shot_spec": shot_spec,
+        "fps": fps,
+        "resolution": resolution,
+        "engine": engine,
+    }
+    content = json.dumps(fingerprint_data, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(content.encode()).hexdigest()[:24]
+
+
+__all__ = ["previz_generate", "PrevizGenerateError", "compute_fingerprint_for"]
