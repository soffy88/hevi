+                generated_subtitles_path = karaoke_path
+
+        srt_cues = input_data.get("srt_cues")
+        if srt_cues and (subtitles_path is None or not subtitles_path.exists()):
+            srt_path = output_dir / "timeline_assembled.srt"
+            file_write(srt_path, content=cues_to_srt(srt_cues))
