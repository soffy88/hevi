+"""obase.media.blender — Blender runtime adapter.
+
+Provides headless Blender process management, environment sandboxing,
+and virtual framebuffer (Xvfb) or Eevee/Workbench render management.
+"""
+
+from __future__ import annotations
+
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+
+
+@dataclass(frozen=True)
+class BlenderRuntimeInfo:
+    """Blender runtime discovery result."""
+    binary_path: str
+    version: str
+    has_xvfb: bool
+    has_gpu: bool
+
+
+class BlenderNotFoundError(Exception):
+    """Blender binary not found on PATH."""
+
+
+class XvfbNotFoundError(Exception):
+    """Xvfb not found but required."""
+
+
+def discover_blender_runtime(
+    *,
+    require_xvfb: bool = False,
+) -> BlenderRuntimeInfo:
+    """Discover Blender installation and capabilities.
+
+    Args:
+        require_xvfb: If True, raise XvfbNotFoundError if xvfb-run not found.
+
+    Returns:
+        BlenderRuntimeInfo with binary path, version, and capability flags.
+    """
+    blender_bin = shutil.which("blender")
+    if blender_bin is None:
+        raise BlenderNotFoundError("blender binary not found on PATH")
+
+    # Get version
+    import subprocess
+    try:
+        result = subprocess.run(
+            [blender_bin, "--version"],
+            capture_output=True, text=True, check=True,
+        )
+        version_line = result.stdout.splitlines()[0]
+        # "Blender 4.2.0" -> "4.2.0"
+        version = version_line.split()[-1] if version_line.split() else "unknown"
+    except (subprocess.CalledProcessError, IndexError):
+        version = "unknown"
+
+    xvfb_bin = shutil.which("xvfb-run")
+    has_xvfb = xvfb_bin is not None
+
+    if require_xvfb and not has_xvfb:
+        raise XvfbNotFoundError("xvfb-run not found but required for headless rendering")
+
+    # Simple GPU check (nvidia-smi)
+    has_gpu = shutil.which("nvidia-smi") is not None
+
+    return BlenderRuntimeInfo(
+        binary_path=blender_bin,
+        version=version,
+        has_xvfb=has_xvfb,
+        has_gpu=has_gpu,
+    )
+
+
+@dataclass(frozen=True)
+class BlenderRenderConfig:
+    """Configuration for headless Blender render."""
+    script_path: Path
+    output_path: Path
+    fps: int = 24
+    resolution: tuple[int, int] = (1080, 1920)
+    engine: Literal["BLENDER_WORKBENCH", "BLENDER_EEVEE", "CYCLES"] = "BLENDER_WORKBENCH"
+    xvfb: bool = True
+    timeout_s: float = 600.0
+
+
+def build_render_script(config: BlenderRenderConfig) -> str:
+    """Build the complete Blender Python script with render settings injected.
+
+    This is a pure function - no IO, no subprocess.
+    """
+    width, height = config.resolution
+    render_setup = f"""
+import bpy
+bpy.context.scene.render.fps = {config.fps}
+bpy.context.scene.render.resolution_x = {width}
+bpy.context.scene.render.resolution_y = {height}
+bpy.context.scene.render.engine = '{config.engine}'
+bpy.context.scene.render.filepath = '{config.output_path}'
+bpy.context.scene.render.image_settings.file_format = 'FFMPEG'
+bpy.context.scene.render.ffmpeg.format = 'MPEG4'
+bpy.context.scene.render.ffmpeg.codec = 'H264'
+bpy.context.scene.render.ffmpeg.constant_rate_factor = 'PERC_LOSSLESS'
+"""
+    user_script = config.script_path.read_text(encoding="utf-8")
+    return render_setup + "\n" + user_script
+
+
+def build_blender_command(config: BlenderRenderConfig, script_path: Path) -> list[str]:
+    """Build the Blender command line for subprocess execution.
+
+    Pure function - no IO, no subprocess.
+    """
+    blender_bin = shutil.which("blender")
+    if blender_bin is None:
+        raise BlenderNotFoundError("blender binary not found on PATH")
+
+    cmd = [blender_bin, "-b", "-P", str(script_path)]
+    if config.xvfb:
+        xvfb_bin = shutil.which("xvfb-run")
+        if xvfb_bin:
+            cmd = [
+                xvfb_bin, "-a",
+                "--server-args=-screen 0 1920x1080x24",
+                *cmd,
+            ]
+    return cmd
+
+
+__all__ = [
+    "BlenderRuntimeInfo",
+    "BlenderNotFoundError",
+    "XvfbNotFoundError",
+    "discover_blender_runtime",
+    "BlenderRenderConfig",
+    "build_render_script",
+    "build_blender_command",
+]
