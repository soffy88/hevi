+"""obase.media.remotion — Remotion runtime adapter.
+
+Provides Remotion CLI discovery, project validation, and render
+command construction for headless Chromium rendering.
+"""
+
+from __future__ import annotations
+
+import os
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+
+
+@dataclass(frozen=True)
+class RemotionRuntimeInfo:
+    """Remotion runtime discovery result."""
+    cli_path: str
+    project_root: Path
+    version: str
+    has_chromium: bool
+
+
+class RemotionNotFoundError(Exception):
+    """Remotion CLI not found."""
+
+
+class RemotionProjectNotFoundError(Exception):
+    """Remotion project not found at specified path."""
+
+
+def discover_remotion_runtime(
+    project_root: Path | None = None,
+) -> RemotionRuntimeInfo:
+    """Discover Remotion CLI and project.
+
+    Args:
+        project_root: Path to Remotion project (package.json location).
+                      If None, uses HEVI_REMOTION_DIR env var.
+
+    Returns:
+        RemotionRuntimeInfo with CLI path, project root, and capabilities.
+    """
+    if project_root is None:
+        project_root = Path(os.environ.get("HEVI_REMOTION_DIR", "/app/hevi-remotion"))
+    project_root = Path(project_root)
+
+    if not (project_root / "package.json").exists():
+        raise RemotionProjectNotFoundError(f"Remotion project not found at {project_root}")
+
+    # Find Remotion CLI
+    cli_path = shutil.which("remotion")
+    if cli_path is None:
+        local_cli = project_root / "node_modules" / ".bin" / "remotion"
+        if local_cli.exists():
+            cli_path = str(local_cli)
+        else:
+            raise RemotionNotFoundError(
+                "Remotion CLI not found on PATH or in project node_modules/.bin/"
+            )
+
+    # Get version
+    import subprocess
+    try:
+        result = subprocess.run(
+            [cli_path, "--version"],
+            capture_output=True, text=True, check=True,
+        )
+        version = result.stdout.strip()
+    except (subprocess.CalledProcessError, FileNotFoundError):
+        version = "unknown"
+
+    # Check for Chromium (Playwright)
+    has_chromium = False
+    try:
+        from playwright.async_api import async_playwright
+        has_chromium = True
+    except ImportError:
+        pass
+
+    return RemotionRuntimeInfo(
+        cli_path=cli_path,
+        project_root=project_root,
+        version=version,
+        has_chromium=has_chromium,
+    )
+
+
+@dataclass(frozen=True)
+class RemotionRenderConfig:
+    """Configuration for Remotion render."""
+    component_name: str
+    props: dict
+    output_path: Path
+    duration_frames: int
+    fps: int = 24
+    concurrency: int = 4
+    timeout_s: float = 600.0
+
+
+def build_remotion_command(config: RemotionRenderConfig, runtime: RemotionRuntimeInfo) -> list[str]:
+    """Build the Remotion render command.
+
+    Pure function - no IO, no subprocess.
+    """
+    duration_s = config.duration_frames / config.fps
+    return [
+        runtime.cli_path,
+        "render",
+        config.component_name,
+        str(config.output_path),
+        f"--concurrency={config.concurrency}",
+    ]
+
+
+def write_remotion_manifest(project_root: Path, props: dict) -> Path:
+    """Write props to Remotion manifest file.
+
+    Remotion reads from src/data/run_manifest.json by default.
+    """
+    manifest_path = project_root / "src" / "data" / "run_manifest.json"
+    manifest_path.parent.mkdir(parents=True, exist_ok=True)
+    import json
+    manifest_path.write_text(json.dumps(props, ensure_ascii=False, indent=2), encoding="utf-8")
+    return manifest_path
+
+
+__all__ = [
+    "RemotionRuntimeInfo",
+    "RemotionNotFoundError",
+    "RemotionProjectNotFoundError",
+    "discover_remotion_runtime",
+    "RemotionRenderConfig",
+    "build_remotion_command",
+    "write_remotion_manifest",
+]
