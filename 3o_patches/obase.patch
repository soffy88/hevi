+"""obase.storage.blob_store — Content-addressed blob storage mechanism.
+
+Provides put/get/exists/delete operations with SHA256 content addressing
+and deduplication. Pure storage mechanism - no business logic.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import shutil
+from dataclasses import dataclass
+from pathlib import Path
+from typing import BinaryIO
+
+
+@dataclass(frozen=True)
+class BlobRef:
+    """Content-addressed blob reference."""
+    sha256: str
+    size: int
+    mime_type: str | None = None
+
+
+class BlobStoreError(Exception):
+    """Blob store operation failed."""
+
+
+class BlobNotFoundError(BlobStoreError):
+    """Blob not found in store."""
+
+
+class BlobStore:
+    """Content-addressed blob storage.
+
+    Stores blobs under <root>/sha256[:2]/sha256[2:4]/sha256
+    for filesystem-friendly sharding.
+    """
+
+    def __init__(self, root: Path | str):
+        self.root = Path(root)
+        self.root.mkdir(parents=True, exist_ok=True)
+
+    def _blob_path(self, sha256: str) -> Path:
+        """Get filesystem path for blob (sharded)."""
+        return self.root / sha256[:2] / sha256[2:4] / sha256
+
+    def _compute_sha256(self, data: bytes) -> str:
+        return hashlib.sha256(data).hexdigest()
+
+    async def put(
+        self,
+        content: bytes,
+        *,
+        mime_type: str | None = None,
+    ) -> BlobRef:
+        """Store blob and return content-addressed reference.
+
+        Args:
+            content: Blob bytes.
+            mime_type: Optional MIME type for metadata.
+
+        Returns:
+            BlobRef with sha256, size, and mime_type.
+        """
+        sha256 = self._compute_sha256(content)
+        size = len(content)
+        blob_path = self._blob_path(sha256)
+
+        # Dedupe: if already exists, just return ref
+        if blob_path.exists():
+            return BlobRef(sha256=sha256, size=size, mime_type=mime_type)
+
+        blob_path.parent.mkdir(parents=True, exist_ok=True)
+        blob_path.write_bytes(content)
+
+        return BlobRef(sha256=sha256, size=size, mime_type=mime_type)
+
+    async def put_file(
+        self,
+        file_path: Path,
+        *,
+        mime_type: str | None = None,
+    ) -> BlobRef:
+        """Store file and return content-addressed reference.
+
+        Args:
+            file_path: Path to file to store.
+            mime_type: Optional MIME type.
+
+        Returns:
+            BlobRef with sha256, size, and mime_type.
+        """
+        content = file_path.read_bytes()
+        return await self.put(content, mime_type=mime_type)
+
+    async def get(self, ref: BlobRef) -> bytes:
+        """Retrieve blob content by reference.
+
+        Args:
+            ref: BlobRef returned from put().
+
+        Returns:
+            Blob content as bytes.
+
+        Raises:
+            BlobNotFoundError: If blob not found.
+        """
+        blob_path = self._blob_path(ref.sha256)
+        if not blob_path.exists():
+            raise BlobNotFoundError(f"Blob not found: {ref.sha256}")
+        return blob_path.read_bytes()
+
+    async def get_to_file(self, ref: BlobRef, dest_path: Path) -> Path:
+        """Retrieve blob and write to destination file.
+
+        Args:
+            ref: BlobRef returned from put().
+            dest_path: Destination file path.
+
+        Returns:
+            dest_path on success.
+
+        Raises:
+            BlobNotFoundError: If blob not found.
+        """
+        blob_path = self._blob_path(ref.sha256)
+        if not blob_path.exists():
+            raise BlobNotFoundError(f"Blob not found: {ref.sha256}")
+        dest_path.parent.mkdir(parents=True, exist_ok=True)
+        shutil.copy2(blob_path, dest_path)
+        return dest_path
+
+    async def exists(self, ref: BlobRef) -> bool:
+        """Check if blob exists in store."""
+        return self._blob_path(ref.sha256).exists()
+
+    async def delete(self, ref: BlobRef) -> bool:
+        """Delete blob from store.
+
+        Returns:
+            True if blob was deleted, False if not found.
+        """
+        blob_path = self._blob_path(ref.sha256)
+        if blob_path.exists():
+            blob_path.unlink()
+            # Clean up empty parent dirs
+            for parent in [blob_path.parent, blob_path.parent.parent]:
+                try:
+                    parent.rmdir()
+                except OSError:
+                    break
+            return True
+        return False
+
+    def path(self, ref: BlobRef) -> Path:
+        """Get local filesystem path for blob (for subprocess access).
+
+        Note: Only valid while blob exists in store.
+        """
+        return self._blob_path(ref.sha256)
+
+    async def stat(self, ref: BlobRef) -> BlobRef | None:
+        """Get blob metadata without reading content."""
+        blob_path = self._blob_path(ref.sha256)
+        if not blob_path.exists():
+            return None
+        stat = blob_path.stat()
+        return BlobRef(
+            sha256=ref.sha256,
+            size=stat.st_size,
+            mime_type=ref.mime_type,
+        )
+
+
+__all__ = [
+    "BlobRef",
+    "BlobStoreError",
+    "BlobNotFoundError",
+    "BlobStore",
+]
