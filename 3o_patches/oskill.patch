+"""oskill.timeline_math — Pure algorithms for timecode and frame alignment.
+
+All functions are pure, stateless, deterministic. No IO, no network, no subprocess.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def calc_timecode_alignment(
+    asr_segments: list[dict[str, Any]],
+    *,
+    fps: int = 24,
+    total_audio_ms: int,
+    rounding: str = "floor",
+) -> list[dict[str, Any]]:
+    """Align ASR word timestamps to physical frame numbers, eliminating drift.
+
+    Args:
+        asr_segments: List of dicts with keys:
+            - "start": float (seconds)
+            - "end": float (seconds)
+            - "text": str
+            - "words": optional list of word dicts with "start", "end", "text"
+        fps: Frame rate for alignment
+        total_audio_ms: Total audio duration in milliseconds
+        rounding: Rounding policy for frame calculation ("floor", "round", "ceil")
+
+    Returns:
+        List of aligned shot dicts with:
+            - "shot_id": int
+            - "start_frame": int
+            - "end_frame": int
+            - "start_ms": int
+            - "end_ms": int
+            - "text": str
+            - "words": list of aligned word dicts
+
+    Formula:
+        frame = floor((timestamp_ms / 1000) * fps)  # when rounding="floor"
+    """
+    if not asr_segments:
+        return []
+
+    def ms_to_frame(ms: float) -> int:
+        frames = (ms / 1000.0) * fps
+        if rounding == "floor":
+            return int(frames)
+        if rounding == "round":
+            return int(frames + 0.5)
+        if rounding == "ceil":
+            return int(frames + 0.999999)
+        raise ValueError(f"Unknown rounding policy: {rounding}")
+
+    aligned: list[dict[str, Any]] = []
+    for shot_idx, seg in enumerate(asr_segments):
+        start_s = float(seg.get("start", 0.0))
+        end_s = float(seg.get("end", 0.0))
+        text = str(seg.get("text", "")).strip()
+
+        start_ms = round(start_s * 1000)
+        end_ms = round(end_s * 1000)
+
+        # Clamp to audio boundaries
+        start_ms = max(0, min(start_ms, total_audio_ms))
+        end_ms = max(0, min(end_ms, total_audio_ms))
+
+        if end_ms <= start_ms:
+            continue
+
+        start_frame = ms_to_frame(start_ms)
+        end_frame = ms_to_frame(end_ms)
+
+        # Align words if present
+        aligned_words = []
+        for word in seg.get("words", []):
+            w_start_ms = round(float(word.get("start", 0.0)) * 1000)
+            w_end_ms = round(float(word.get("end", 0.0)) * 1000)
+            w_start_ms = max(0, min(w_start_ms, total_audio_ms))
+            w_end_ms = max(0, min(w_end_ms, total_audio_ms))
+            if w_end_ms > w_start_ms:
+                aligned_words.append({
+                    "text": word.get("text", ""),
+                    "start_ms": w_start_ms,
+                    "end_ms": w_end_ms,
+                    "start_frame": ms_to_frame(w_start_ms),
+                    "end_frame": ms_to_frame(w_end_ms),
+                })
+
+        aligned.append({
+            "shot_id": shot_idx,
+            "start_ms": start_ms,
+            "end_ms": end_ms,
+            "start_frame": start_frame,
+            "end_frame": end_frame,
+            "text": text,
+            "words": aligned_words,
+        })
+
+    return aligned
+
+
+def calculate_shot_durations(
+    native_durations: list[float],
+    total_audio_s: float,
+    *,
+    min_shot_duration_s: float = 0.8,
+) -> list[float]:
+    """Calculate audio-driven shot durations (port of HEVI orchestrator logic).
+
+    Args:
+        native_durations: List of original shot durations in seconds
+        total_audio_s: Total narration audio duration in seconds
+        min_shot_duration_s: Minimum duration per shot
+
+    Returns:
+        List of target durations per shot
+    """
+    if not native_durations:
+        return []
+
+    sum_native = sum(d for d in native_durations if d > 0) or float(len(native_durations))
+    effective_total = max(total_audio_s, sum_native) if total_audio_s > 0 else 0.0
+
+    if effective_total <= 0:
+        return [None] * len(native_durations)
+
+    target_durations = []
+    for nat in native_durations:
+        nat = nat if nat > 0 else sum_native / len(native_durations)
+        share = nat / sum_native
+        target = max(min_shot_duration_s, effective_total * share)
+        target_durations.append(target)
+
+    return target_durations
+
+
+__all__ = ["calc_timecode_alignment", "calculate_shot_durations"]
