+"""oskill.previz_compiler — Pure compilation from shot spec to Blender Python script.
+
+All functions are pure, stateless, deterministic. No IO, no network, no subprocess.
+"""
+
+from __future__ import annotations
+
+import math
+from typing import Any
+
+
+def build_previz_bpy_script(
+    shot_spec: dict[str, Any],
+    *,
+    scene_type: str = "geometry_block",
+    camera_motion: str = "dolly_in",
+    actor_action: str = "walk_and_stop",
+    resolution: tuple[int, int] = (1080, 1920),
+    fps: int = 24,
+    duration_s: float = 5.0,
+) -> str:
+    """Compile deterministic Blender Python (bpy) script from shot specification.
+
+    Args:
+        shot_spec: Shot specification dict with keys:
+            - "shot_id": str
+            - "scene_type": "geometry_block" | "character_block" | "environment"
+            - "camera_motion": "dolly_in" | "dolly_out" | "tracking_left" | "tracking_right" | "orbital" | "pan" | "static"
+            - "actor_action": "walk_and_stop" | "idle" | "gesture" | "sit_stand"
+            - "duration_s": float
+        scene_type: Override scene type
+        camera_motion: Override camera motion
+        actor_action: Override actor action
+        resolution: (width, height) in pixels
+        fps: Frame rate
+        duration_s: Shot duration in seconds
+
+    Returns:
+        Complete Blender Python script as string, ready for headless execution.
+    """
+    width, height = resolution
+    shot_id = shot_spec.get("shot_id", "001")
+    duration_s = shot_spec.get("duration_s", duration_s)
+    total_frames = int(duration_s * fps)
+
+    # Camera motion parameters
+    camera_params = _get_camera_params(camera_motion, total_frames, resolution)
+    actor_params = _get_actor_params(actor_action, total_frames)
+
+    script = f'''"""
+Auto-generated Blender script for shot {shot_id}
+Scene: {scene_type} | Camera: {camera_motion} | Actor: {actor_action}
+Duration: {duration_s}s @ {fps}fps = {total_frames} frames
+Resolution: {width}x{height}
+"""
+
+import bpy
+import math
+
+# Clear scene
+bpy.ops.object.select_all(action='SELECT')
+bpy.ops.object.delete()
+
+# Set render settings
+scene = bpy.context.scene
+scene.render.fps = {fps}
+scene.render.resolution_x = {width}
+scene.render.resolution_y = {height}
+scene.render.resolution_percentage = 100
+scene.render.engine = 'BLENDER_WORKBENCH'
+scene.render.filepath = '/tmp/shot_{shot_id}.mp4'
+scene.render.image_settings.file_format = 'FFMPEG'
+scene.render.ffmpeg.format = 'MPEG4'
+scene.render.ffmpeg.codec = 'H264'
+scene.render.ffmpeg.constant_rate_factor = 'PERC_LOSSLESS'
+
+# World setup
+world = bpy.data.worlds.new("World")
+world.use_nodes = True
+bg = world.node_tree.nodes["Background"]
+bg.inputs[0].default_value = (0.1, 0.1, 0.12, 1.0)
+bg.inputs[1].default_value = 0.5
+scene.world = world
+
+# Camera
+cam_data = bpy.data.cameras.new("Camera")
+cam_obj = bpy.data.objects.new("Camera", cam_data)
+scene.collection.objects.link(cam_obj)
+scene.camera = cam_obj
+cam_obj.location = (0, -10, 2)
+cam_obj.rotation_euler = (math.radians(90), 0, 0)
+cam_data.lens = 35
+cam_data.sensor_width = 36
+
+# Ground plane
+bpy.ops.mesh.primitive_plane_add(size=100, location=(0, 0, 0))
+ground = bpy.context.active_object
+ground.name = "Ground"
+mat = bpy.data.materials.new(name="GroundMat")
+mat.use_nodes = True
+bsdf = mat.node_tree.nodes["Principled BSDF"]
+bsdf.inputs[0].default_value = (0.2, 0.2, 0.22, 1.0)
+bsdf.inputs[4].default_value = 0.8  # roughness
+ground.data.materials.append(mat)
+
+# Scene content based on type
+'''
+
+    # Add scene-specific content
+    if scene_type == "geometry_block":
+        script += _build_geometry_block_scene()
+    elif scene_type == "character_block":
+        script += _build_character_block_scene(actor_params)
+    elif scene_type == "environment":
+        script += _build_environment_scene()
+    else:
+        script += _build_geometry_block_scene()
+
+    # Add camera animation
+    script += _build_camera_animation(camera_params, total_frames)
+
+    # Add actor animation if character scene
+    if scene_type == "character_block":
+        script += _build_actor_animation(actor_params, total_frames)
+
+    # Final render
+    script += f'''
+# Render
+bpy.ops.render.render(animation=True, write_still=False)
+print(f"Shot {shot_id} render complete")
+'''
+
+    return script
+
+
+def _get_camera_params(motion: str, total_frames: int, resolution: tuple[int, int]) -> dict[str, Any]:
+    """Generate camera animation parameters from motion type."""
+    _width, _height = resolution
+    params = {
+        "motion": motion,
+        "total_frames": total_frames,
+        "start_loc": (0, -10, 2),
+        "end_loc": (0, -10, 2),
+        "start_rot": (math.radians(90), 0, 0),
+        "end_rot": (math.radians(90), 0, 0),
+    }
+
+    if motion == "dolly_in":
+        params["end_loc"] = (0, -3, 1.5)
+    elif motion == "dolly_out":
+        params["start_loc"] = (0, -3, 1.5)
+        params["end_loc"] = (0, -15, 3)
+    elif motion == "tracking_left":
+        params["start_loc"] = (5, -10, 2)
+        params["end_loc"] = (-5, -10, 2)
+    elif motion == "tracking_right":
+        params["start_loc"] = (-5, -10, 2)
+        params["end_loc"] = (5, -10, 2)
+    elif motion == "orbital":
+        # Orbital around origin
+        params["start_loc"] = (10, 0, 2)
+        params["end_loc"] = (-10, 0, 2)
+        params["start_rot"] = (math.radians(90), 0, math.radians(0))
+        params["end_rot"] = (math.radians(90), 0, math.radians(180))
+    elif motion == "pan":
+        params["start_rot"] = (math.radians(90), 0, math.radians(-15))
+        params["end_rot"] = (math.radians(90), 0, math.radians(15))
+
+    return params
+
+
+def _get_actor_params(action: str, total_frames: int) -> dict[str, Any]:
+    """Generate actor animation parameters from action type."""
+    params = {"action": action, "total_frames": total_frames}
+
+    if action == "walk_and_stop":
+        params["walk_frames"] = int(total_frames * 0.6)
+        params["stop_frame"] = int(total_frames * 0.6)
+    elif action == "idle":
+        params["idle_frames"] = total_frames
+    elif action == "gesture":
+        params["gesture_start"] = int(total_frames * 0.2)
+        params["gesture_end"] = int(total_frames * 0.8)
+    elif action == "sit_stand":
+        params["sit_frame"] = int(total_frames * 0.3)
+        params["stand_frame"] = int(total_frames * 0.7)
+
+    return params
+
+
+def _build_geometry_block_scene() -> str:
+    return '''
+# Geometry block scene - simple colored cubes
+for i in range(5):
+    bpy.ops.mesh.primitive_cube_add(size=1, location=(i * 2.5 - 5, 0, 0.5))
+    cube = bpy.context.active_object
+    cube.name = f"Block_{{i}}"
+    mat = bpy.data.materials.new(name=f"BlockMat_{{i}}")
+    mat.use_nodes = True
+    bsdf = mat.node_tree.nodes["Principled BSDF"]
+    hue = i / 5.0
+    bsdf.inputs[0].default_value = (hue, 0.5, 1.0, 1.0)  # HSV-like
+    bsdf.inputs[4].default_value = 0.3
+    cube.data.materials.append(mat)
+'''
+
+
+def _build_character_block_scene(actor_params: dict) -> str:
+    return '''
+# Character block - simple humanoid proxy
+# Body
+bpy.ops.mesh.primitive_cylinder_add(radius=0.3, depth=1.8, location=(0, 0, 0.9))
+body = bpy.context.active_object
+body.name = "Actor_Body"
+mat = bpy.data.materials.new(name="ActorMat")
+mat.use_nodes = True
+bsdf = mat.node_tree.nodes["Principled BSDF"]
+bsdf.inputs[0].default_value = (0.8, 0.6, 0.4, 1.0)  # Skin tone
+bsdf.inputs[4].default_value = 0.5
+body.data.materials.append(mat)
+
+# Head
+bpy.ops.mesh.primitive_uv_sphere_add(radius=0.25, location=(0, 0, 1.95))
+head = bpy.context.active_object
+head.name = "Actor_Head"
+head.data.materials.append(mat)
+'''
+
+
+def _build_environment_scene() -> str:
+    return '''
+# Environment - simple room with lighting
+# Walls
+for name, loc, rot in [
+    ("Wall_Back", (0, 5, 2), (0, 0, 0)),
+    ("Wall_Left", (-5, 0, 2), (0, 0, 1.5708)),
+    ("Wall_Right", (5, 0, 2), (0, 0, -1.5708)),
+]:
+    bpy.ops.mesh.primitive_plane_add(size=10, location=loc)
+    wall = bpy.context.active_object
+    wall.name = name
+    wall.rotation_euler = rot
+    mat = bpy.data.materials.new(name=f"{name}Mat")
+    mat.use_nodes = True
+    bsdf = mat.node_tree.nodes["Principled BSDF"]
+    bsdf.inputs[0].default_value = (0.3, 0.3, 0.35, 1.0)
+    bsdf.inputs[4].default_value = 0.9
+    wall.data.materials.append(mat)
+
+# Key light
+light_data = bpy.data.lights.new(name="KeyLight", type='SUN')
+light_obj = bpy.data.objects.new(name="KeyLight", object_data=light_data)
+scene = bpy.context.scene
+scene.collection.objects.link(light_obj)
+light_obj.location = (5, -5, 10)
+light_obj.rotation_euler = (0.785, 0, -0.785)
+light_data.energy = 3.0
+light_data.color = (1.0, 0.95, 0.9)
+'''
+
+
+def _build_camera_animation(camera_params: dict, total_frames: int) -> str:
+    motion = camera_params["motion"]
+    start_loc = camera_params["start_loc"]
+    end_loc = camera_params["end_loc"]
+    start_rot = camera_params["start_rot"]
+    end_rot = camera_params["end_rot"]
+
+    return f'''
+# Camera animation: {motion}
+cam_obj = bpy.data.objects["Camera"]
+cam_obj.location = {start_loc}
+cam_obj.rotation_euler = {start_rot}
+cam_obj.keyframe_insert(data_path="location", frame=1)
+cam_obj.keyframe_insert(data_path="rotation_euler", frame=1)
+
+cam_obj.location = {end_loc}
+cam_obj.rotation_euler = {end_rot}
+cam_obj.keyframe_insert(data_path="location", frame={total_frames})
+cam_obj.keyframe_insert(data_path="rotation_euler", frame={total_frames})
+
+# Linear interpolation
+for fcu in cam_obj.animation_data.action.fcurves:
+    for kf in fcu.keyframe_points:
+        kf.interpolation = 'LINEAR'
+'''
+
+
+def _build_actor_animation(actor_params: dict, total_frames: int) -> str:
+    action = actor_params["action"]
+
+    if action == "walk_and_stop":
+        walk_frames = actor_params["walk_frames"]
+        return f'''
+# Actor animation: walk_and_stop
+body = bpy.data.objects["Actor_Body"]
+head = bpy.data.objects["Actor_Head"]
+
+# Walk cycle (simplified: forward translation)
+body.location = (0, 0, 0.9)
+body.keyframe_insert(data_path="location", frame=1)
+
+body.location = (0, {walk_frames * 0.1:.1f}, 0.9)
+body.keyframe_insert(data_path="location", frame={walk_frames})
+
+# Stop
+body.location = (0, {walk_frames * 0.1:.1f}, 0.9)
+body.keyframe_insert(data_path="location", frame={total_frames})
+head.keyframe_insert(data_path="location", frame={total_frames})
+
+for fcu in body.animation_data.action.fcurves:
+    for kf in fcu.keyframe_points:
+        kf.interpolation = 'LINEAR'
+'''
+    if action == "idle":
+        return '''
+# Actor animation: idle (breathing)
+body = bpy.data.objects["Actor_Body"]
+body.location = (0, 0, 0.9)
+body.keyframe_insert(data_path="location", frame=1)
+body.location = (0, 0, 0.92)
+body.keyframe_insert(data_path="location", frame={total_frames // 2})
+body.location = (0, 0, 0.9)
+body.keyframe_insert(data_path="location", frame={total_frames})
+'''
+    if action == "gesture":
+        gesture_start = actor_params["gesture_start"]
+        gesture_end = actor_params["gesture_end"]
+        return f'''
+# Actor animation: gesture
+body = bpy.data.objects["Actor_Body"]
+head = bpy.data.objects["Actor_Head"]
+
+# Neutral
+body.rotation_euler = (0, 0, 0)
+body.keyframe_insert(data_path="rotation_euler", frame=1)
+
+# Gesture
+body.rotation_euler = (0, 0, 0.3)
+body.keyframe_insert(data_path="rotation_euler", frame={gesture_start})
+body.rotation_euler = (0, -0.2, 0.5)
+body.keyframe_insert(data_path="rotation_euler", frame={gesture_end})
+
+# Back to neutral
+body.rotation_euler = (0, 0, 0)
+body.keyframe_insert(data_path="rotation_euler", frame={total_frames})
+'''
+    if action == "sit_stand":
+        sit_frame = actor_params["sit_frame"]
+        stand_frame = actor_params["stand_frame"]
+        return f'''
+# Actor animation: sit_stand
+body = bpy.data.objects["Actor_Body"]
+
+# Stand
+body.location = (0, 0, 0.9)
+body.scale = (1, 1, 1)
+body.keyframe_insert(data_path="location", frame=1)
+body.keyframe_insert(data_path="scale", frame=1)
+
+# Sit
+body.location = (0, 0, 0.5)
+body.scale = (1, 1, 0.6)
+body.keyframe_insert(data_path="location", frame={sit_frame})
+body.keyframe_insert(data_path="scale", frame={sit_frame})
+
+# Stand again
+body.location = (0, 0, 0.9)
+body.scale = (1, 1, 1)
+body.keyframe_insert(data_path="location", frame={stand_frame})
+body.keyframe_insert(data_path="scale", frame={stand_frame})
+
+for fcu in body.animation_data.action.fcurves:
+    for kf in fcu.keyframe_points:
+        kf.interpolation = 'LINEAR'
+'''
+    return ''
+
+
+__all__ = ["build_previz_bpy_script"]
