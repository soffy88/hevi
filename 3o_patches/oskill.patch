+"""oskill.quality — Pure quality assessment algorithms.
+
+All functions are pure, stateless, deterministic. No IO, no network, no subprocess.
+"""
+
+from __future__ import annotations
+
+
+def compute_camera_drift_score(
+    previz_motion_vectors: list[list[float]],
+    v2v_motion_vectors: list[list[float]],
+    *,
+    method: str = "angular_variance",
+) -> float:
+    """Compute camera drift score between previz and V2V motion vectors.
+
+    Args:
+        previz_motion_vectors: List of [dx, dy] motion vectors from previz (per frame)
+        v2v_motion_vectors: List of [dx, dy] motion vectors from V2V output (per frame)
+        method: Scoring method ("angular_variance", "cosine_similarity", "magnitude_diff")
+
+    Returns:
+        Drift score in [0.0, 1.0] where:
+        - 0.0 = perfect alignment (no drift)
+        - 1.0 = maximum drift
+
+    Note:
+        This is a PURE ALGORITHM. It does NOT:
+        - Read video files
+        - Extract optical flow (that's oprim/obase)
+        - Run models
+        - Make business decisions (thresholds, pass/fail)
+    """
+    if not previz_motion_vectors or not v2v_motion_vectors:
+        return 1.0  # No data = maximum drift
+
+    # Align lengths (use minimum)
+    n = min(len(previz_motion_vectors), len(v2v_motion_vectors))
+    if n == 0:
+        return 1.0
+
+    previz = previz_motion_vectors[:n]
+    v2v = v2v_motion_vectors[:n]
+
+    if method == "angular_variance":
+        return _angular_variance_score(previz, v2v)
+    if method == "cosine_similarity":
+        return _cosine_similarity_score(previz, v2v)
+    if method == "magnitude_diff":
+        return _magnitude_diff_score(previz, v2v)
+    raise ValueError(f"Unknown method: {method}")
+
+
+def _angular_variance_score(
+    previz: list[list[float]],
+    v2v: list[list[float]],
+) -> float:
+    """Compute angular variance between motion vector sequences."""
+    angles = []
+    for p_vec, v_vec in zip(previz, v2v, strict=False):
+        if len(p_vec) >= 2 and len(v_vec) >= 2:
+            p_angle = _vector_angle(p_vec[0], p_vec[1])
+            v_angle = _vector_angle(v_vec[0], v_vec[1])
+            diff = abs(p_angle - v_angle)
+            # Normalize to [0, pi]
+            diff = min(diff, 2 * 3.14159265359 - diff)
+            angles.append(diff)
+
+    if not angles:
+        return 1.0
+
+    # Mean angular deviation normalized to [0, 1]
+    mean_diff = sum(angles) / len(angles)
+    return min(1.0, mean_diff / 3.14159265359)
+
+
+def _cosine_similarity_score(
+    previz: list[list[float]],
+    v2v: list[list[float]],
+) -> float:
+    """Compute mean cosine similarity between motion vectors."""
+    similarities = []
+    for p_vec, v_vec in zip(previz, v2v, strict=False):
+        if len(p_vec) >= 2 and len(v_vec) >= 2:
+            sim = _cosine_sim(p_vec, v_vec)
+            similarities.append(sim)
+
+    if not similarities:
+        return 1.0
+
+    mean_sim = sum(similarities) / len(similarities)
+    # Convert similarity [0,1] to drift [0,1] where 0=perfect, 1=max drift
+    return 1.0 - mean_sim
+
+
+def _magnitude_diff_score(
+    previz: list[list[float]],
+    v2v: list[list[float]],
+) -> float:
+    """Compute normalized magnitude difference."""
+    diffs = []
+    for p_vec, v_vec in zip(previz, v2v, strict=False):
+        if len(p_vec) >= 2 and len(v_vec) >= 2:
+            p_mag = _magnitude(p_vec)
+            v_mag = _magnitude(v_vec)
+            if p_mag > 0 or v_mag > 0:
+                diff = abs(p_mag - v_mag) / max(p_mag, v_mag)
+                diffs.append(diff)
+
+    if not diffs:
+        return 1.0
+
+    return sum(diffs) / len(diffs)
+
+
+def _vector_angle(x: float, y: float) -> float:
+    """Calculate angle of 2D vector in radians."""
+    import math
+    return math.atan2(y, x)
+
+
+def _cosine_sim(a: list[float], b: list[float]) -> float:
+    """Cosine similarity between two vectors."""
+    import math
+    dot = sum(ai * bi for ai, bi in zip(a, b, strict=False))
+    mag_a = math.sqrt(sum(ai * ai for ai in a))
+    mag_b = math.sqrt(sum(bi * bi for bi in b))
+    if mag_a == 0 or mag_b == 0:
+        return 0.0
+    return max(-1.0, min(1.0, dot / (mag_a * mag_b)))
+
+
+def _magnitude(v: list[float]) -> float:
+    """Magnitude of vector."""
+    import math
+    return math.sqrt(sum(vi * vi for vi in v))
+
+
+def compute_luma_correction(
+    luma: float,
+    target_luma: float,
+    *,
+    max_delta: float = 0.15,
+) -> float:
+    """Convert luma difference to ffmpeg eq brightness parameter [-1, 1].
+
+    Args:
+        luma: Measured luma (0-255 average grayscale)
+        target_luma: Target luma (0-255)
+        max_delta: Maximum correction in ffmpeg eq units (±max_delta)
+
+    Returns:
+        Brightness correction in [-max_delta, max_delta]
+
+    Formula:
+        diff = (target_luma - luma) / 255.0
+        correction = clamp(diff, -max_delta, max_delta)
+    """
+    diff = (target_luma - luma) / 255.0
+    return max(-max_delta, min(max_delta, diff))
+
+
+def compute_shot_luma_corrections(
+    shot_lumas: list[float | None],
+    *,
+    max_delta: float = 0.15,
+) -> list[float]:
+    """Compute luma corrections for multiple shots targeting global average.
+
+    Args:
+        shot_lumas: List of per-shot luma measurements (None = failed measurement)
+        max_delta: Maximum correction per shot
+
+    Returns:
+        List of brightness corrections (same length as input)
+    """
+    valid = [x for x in shot_lumas if x is not None]
+    if not valid:
+        return [0.0] * len(shot_lumas)
+
+    target_luma = sum(valid) / len(valid)
+    return [
+        compute_luma_correction(lm, target_luma, max_delta=max_delta)
+        if lm is not None else 0.0
+        for lm in shot_lumas
+    ]
+
+
+__all__ = [
+    "compute_camera_drift_score",
+    "compute_luma_correction",
+    "compute_shot_luma_corrections",
+]
