+"""oskill.subtitle — Pure subtitle text generation algorithms.
+
+All functions are pure, stateless, deterministic. No IO, no network, no subprocess.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def cues_to_srt(cues: list[dict[str, Any]]) -> str:
+    """Convert cue list to SRT text.
+
+    Args:
+        cues: List of dicts with keys:
+            - "start": float (seconds)
+            - "end": float (seconds)
+            - "text": str
+
+    Returns:
+        SRT formatted string.
+    """
+    if not cues:
+        return ""
+
+    def fmt_ts(seconds: float) -> str:
+        if seconds < 0:
+            seconds = 0.0
+        ms = round(seconds * 1000)
+        h, ms = divmod(ms, 3_600_000)
+        m, ms = divmod(ms, 60_000)
+        s, ms = divmod(ms, 1000)
+        return f"{h:02d}:{m:02d}:{s:02d},{ms:03d}"
+
+    blocks: list[str] = []
+    for i, c in enumerate(cues, 1):
+        start = float(c.get("start", 0.0))
+        end = float(c.get("end", 0.0))
+        text = str(c.get("text", "")).strip()
+        blocks.append(f"{i}\n{fmt_ts(start)} --> {fmt_ts(end)}\n{text}\n")
+
+    return "\n".join(blocks)
+
+
+def generate_ass_karaoke(
+    aligned_words: list[dict[str, Any]],
+    *,
+    style_spec: dict[str, Any] | None = None,
+    screen_resolution: tuple[int, int] = (1080, 1920),
+    fps: int = 24,
+) -> str:
+    """Generate ASS subtitle content with karaoke \\k tags from aligned words.
+
+    Args:
+        aligned_words: List of dicts with keys:
+            - "text": str (word or phrase)
+            - "start_frame": int
+            - "end_frame": int
+            - "start_ms": int (optional)
+            - "end_ms": int (optional)
+        style_spec: Optional style dict with keys:
+            - "FontName": str
+            - "FontSize": int
+            - "PrimaryColour": str (ASS color format, e.g. "&HFFFFFF&")
+            - "OutlineColour": str
+            - "Outline": int
+            - "Shadow": int
+            - "Alignment": int (1-9)
+            - "MarginV": int
+        screen_resolution: (width, height) for scaling
+
+    Returns:
+        Complete ASS file content as string.
+    """
+    if not aligned_words:
+        return _ass_header(style_spec, screen_resolution) + "\n"
+
+    _width, _height = screen_resolution
+
+    # Default style
+    style = {
+        "FontName": "Arial",
+        "FontSize": 48,
+        "PrimaryColour": "&HFFFFFF&",
+        "OutlineColour": "&H000000&",
+        "Outline": 2,
+        "Shadow": 1,
+        "Alignment": 2,  # Bottom center
+        "MarginV": 60,
+    }
+    if style_spec:
+        style.update(style_spec)
+
+    # Build header
+    header = _ass_header(style, screen_resolution)
+
+    # Build dialogue lines with karaoke tags
+    dialogue_lines = []
+    for word_data in aligned_words:
+        text = str(word_data.get("text", "")).strip()
+        if not text:
+            continue
+
+        start_frame = int(word_data.get("start_frame", 0))
+        end_frame = int(word_data.get("end_frame", 0))
+
+        # Convert frames to centiseconds (ASS time unit = 1/100 sec).
+        start_cs = round(start_frame * 100 / fps)
+        end_cs = round(end_frame * 100 / fps)
+
+        duration_cs = end_cs - start_cs
+        if duration_cs <= 0:
+            continue
+
+        # Karaoke tag: {\\k<duration>}text
+        # For per-character karaoke, we'd need character-level timing
+        # Here we use word-level karaoke
+        k_tag = f"{{\\k{duration_cs}}}"
+        ass_text = f"{k_tag}{text}"
+
+        # ASS dialogue format: Dialogue: Layer,Start,End,Style,Name,MarginL,MarginR,MarginV,Effect,Text
+        start_time = _cs_to_ass_time(start_cs)
+        end_time = _cs_to_ass_time(end_cs)
+        dialogue_lines.append(
+            f"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{ass_text}"
+        )
+
+    return header + "\n".join(dialogue_lines)
+
+
+def _ass_header(style: dict[str, Any], resolution: tuple[int, int]) -> str:
+    """Generate ASS file header with style definitions."""
+    width, height = resolution
+    return f"""[Script Info]
+Title: HEVI Generated Subtitles
+ScriptType: v4.00+
+WrapStyle: 0
+ScaledBorderAndShadow: yes
+YCbCr Matrix: TV.709
+PlayResX: {width}
+PlayResY: {height}
+
+[V4+ Styles]
+Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
+Style: Default,{style['FontName']},{style['FontSize']},{style['PrimaryColour']},{style['PrimaryColour']},{style['OutlineColour']},&H000000&,-1,0,0,0,100,100,0,0,1,{style['Outline']},{style['Shadow']},{style['Alignment']},10,10,{style['MarginV']},1
+
+[Events]
+Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
+"""
+
+
+def _cs_to_ass_time(cs: int) -> str:
+    """Convert centiseconds to ASS time format H:MM:SS.cc"""
+    if cs < 0:
+        cs = 0
+    h = cs // 360000
+    cs -= h * 360000
+    m = cs // 6000
+    cs -= m * 6000
+    s = cs // 100
+    cs -= s * 100
+    return f"{h}:{m:02d}:{s:02d}.{cs:02d}"
+
+
+__all__ = ["cues_to_srt", "generate_ass_karaoke"]
