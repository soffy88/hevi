+"""oskill.budget — Pure shot budget allocation algorithms.
+
+All functions are pure, stateless, deterministic. No IO, no network, no subprocess.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+
+def resolve_shot_budget(
+    duration_archetype: str,
+    quality_profile: str,
+    *,
+    single_variant: bool = False,
+    total_budget_usd: float | None = None,
+    provider_costs: dict[str, float] | None = None,
+    min_shots: int = 1,
+    max_shots: int | None = None,
+) -> dict[str, Any]:
+    """Resolve shot budget allocation from constraints.
+
+    Args:
+        duration_archetype: "short" | "1-5min" | "5-15min" | "15-30min" | "30-60min"
+        quality_profile: "standard" | "high" | "ultra"
+        single_variant: Force single variant per shot
+        total_budget_usd: Optional hard budget cap
+        provider_costs: Optional dict of provider -> cost per shot
+        min_shots: Minimum shots
+        max_shots: Maximum shots (None = archetype default)
+
+    Returns:
+        Dict with:
+            - "variants_per_shot": int
+            - "max_shots": int
+            - "total_timeout_s": float
+            - "estimated_cost_usd": float | None
+    """
+    # Base shot counts by archetype
+    archetype_shots = {
+        "short": 1,
+        "1-5min": 14,
+        "5-15min": 30,
+        "15-30min": 50,
+        "30-60min": 80,
+    }
+    base_shots = archetype_shots.get(duration_archetype, 14)
+
+    # Variant multiplier by quality
+    quality_variants = {
+        "standard": 1,
+        "high": 2,
+        "ultra": 2,
+    }
+    variants = quality_variants.get(quality_profile, 1)
+
+    if single_variant:
+        variants = 1
+
+    # Apply max_shots constraint
+    if max_shots is not None:
+        base_shots = min(base_shots, max_shots)
+
+    base_shots = max(base_shots, min_shots)
+
+    # Estimate cost
+    estimated_cost = None
+    if total_budget_usd is not None and provider_costs:
+        avg_cost = sum(provider_costs.values()) / len(provider_costs)
+        estimated_cost = base_shots * variants * avg_cost
+        # Check if over budget
+        if estimated_cost > total_budget_usd:
+            # Reduce shots to fit budget
+            max_affordable = int(total_budget_usd / (variants * avg_cost))
+            base_shots = max(min_shots, min(base_shots, max_affordable))
+            estimated_cost = base_shots * variants * avg_cost
+
+    # Timeout estimation (seconds per shot * variants * shots)
+    timeout_per_shot = {
+        "standard": 120,
+        "high": 240,
+        "ultra": 300,
+    }
+    per_shot_timeout = timeout_per_shot.get(quality_profile, 120)
+    total_timeout_s = base_shots * variants * per_shot_timeout
+
+    return {
+        "variants_per_shot": variants,
+        "max_shots": base_shots,
+        "total_timeout_s": float(total_timeout_s),
+        "estimated_cost_usd": estimated_cost,
+    }
+
+
+def allocate_budget_per_shot(
+    total_budget_usd: float,
+    shots: list[dict[str, Any]],
+    *,
+    provider_costs: dict[str, float],
+    default_provider: str = "standard",
+) -> list[dict[str, Any]]:
+    """Allocate budget across shots with provider selection.
+
+    Args:
+        total_budget_usd: Total budget available
+        shots: List of shot dicts with optional "quality_tier" and "provider_preference"
+        provider_costs: Dict of provider -> cost per shot
+        default_provider: Fallback provider
+
+    Returns:
+        List of shot dicts with "provider" and "budget_usd" assigned
+    """
+    if not shots:
+        return []
+
+    # Default equal allocation
+    per_shot_budget = total_budget_usd / len(shots)
+    default_cost = provider_costs.get(default_provider, 0)
+
+    allocated = []
+    remaining_budget = total_budget_usd
+
+    for i, shot in enumerate(shots):
+        is_last = (i == len(shots) - 1)
+        pref = shot.get("provider_preference")
+        tier = shot.get("quality_tier", "standard")
+
+        # Determine provider
+        if pref and pref in provider_costs:
+            provider = pref
+        elif tier == "ultra" and "premium" in provider_costs:
+            provider = "premium"
+        elif tier == "high" and "high" in provider_costs:
+            provider = "high"
+        else:
+            provider = default_provider
+
+        cost = provider_costs.get(provider, default_cost)
+
+        budget = remaining_budget if is_last else min(per_shot_budget, remaining_budget)
+
+        # Ensure we can afford at least minimum
+        if budget < cost and not is_last:
+            # Upgrade to cheaper provider if possible
+            affordable = [p for p, c in provider_costs.items() if c <= budget]
+            if affordable:
+                provider = max(affordable, key=lambda p: provider_costs[p])
+                cost = provider_costs[provider]
+
+        allocated.append({
+            **shot,
+            "provider": provider,
+            "budget_usd": budget,
+            "estimated_cost_usd": cost,
+        })
+        remaining_budget -= min(budget, cost)
+
+    return allocated
+
+
+def calculate_cost_breakdown(
+    shots: list[dict[str, Any]],
+    *,
+    provider_costs: dict[str, float],
+) -> dict[str, float]:
+    """Calculate detailed cost breakdown for a shot list.
+
+    Args:
+        shots: List of shot dicts with "provider", "variants" keys
+        provider_costs: Provider -> cost per shot
+
+    Returns:
+        Dict with "total_usd", "by_provider", "by_quality"
+    """
+    total = 0.0
+    by_provider: dict[str, float] = {}
+    by_quality: dict[str, float] = {}
+
+    for shot in shots:
+        provider = shot.get("provider", "unknown")
+        variants = shot.get("variants", 1)
+        quality = shot.get("quality_tier", "standard")
+        cost = provider_costs.get(provider, 0) * variants
+
+        total += cost
+        by_provider[provider] = by_provider.get(provider, 0) + cost
+        by_quality[quality] = by_quality.get(quality, 0) + cost
+
+    return {
+        "total_usd": total,
+        "by_provider": by_provider,
+        "by_quality": by_quality,
+    }
+
+
+__all__ = [
+    "allocate_budget_per_shot",
+    "calculate_cost_breakdown",
+    "resolve_shot_budget",
+]
