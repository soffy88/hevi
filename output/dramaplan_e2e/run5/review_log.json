        "scenes": [
          {
            "scene_no": 1,
            "location": "沈府后院墙头",
            "event_ids": [
              "CH01E001"
            ],
            "summary": "沈砚之因父亲将其未婚妻许配他人而心碎愤怒，深夜翻墙欲逃，怀中藏玉玦作最后纪念，父亲怒斥阻止，他坚持离去以求自由与真爱。",
            "narration": "月色如霜，后院墙头影子摇曳。沈砚之攀墙而上，怀中玉玦微凉，是未婚妻苏晚临别赠物，亦是父亲逼婚的讽刺。",
            "dialogue": [
              {
                "speaker": "沈砚之",
                "text": "父亲，您许我青梅竹马的苏晚给他人，我心如刀绞，不得已才此行。",
                "emotion": "痛苦"
              },
              {
                "speaker": "沈崇山",
                "text": "你若踏出这门，就永别别想认祖归宗！",
                "emotion": "愤怒"
              },
              {
                "speaker": "沈砚之",
                "text": "孩儿不求富贵，只求一心一人。此去若不得所愿，死亦无怨。",
                "emotion": "坚定"
              }
            ],
            "shot_count": 4,
            "duration_s": 45.45454545454545
          },
          {
            "scene_no": 2,
            "location": "东城旧巷口",
            "event_ids": [
              "CH01E002"
            ],
            "summary": "福伯在巷口等候，交付盘缠布包及夫人遗留密信。",
            "narration": "",
            "dialogue": [
              {
                "speaker": "C003",
                "text": "少爷，盘缠我备好了。",
                "emotion": "忠厚"
              },
              {
                "speaker": "C001",
                "text": "多谢福伯。",
                "emotion": "感激"
              }
            ],
            "shot_count": 2,
            "duration_s": 14.545454545454545
          }
        ],
