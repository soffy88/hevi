        "scenes": [
          {
            "scene_no": 1,
            "location": "沈府大厅",
            "event_ids": [
              "CH03E001"
            ],
            "summary": "沈砚之携苏晚归府，先以玉玦为证说明真相，继而倾诉多年误会与父子情深，沈崇山在听闻真相与见证玉玦后，方才痛悔流泪，动机充分铺垫，情感转折自然。",
            "narration": "暮色沉沉，沈府大厅灯火通明。沈砚之携苏晚踏入门槛，手中紧握那枚历经离散的合璧玉玦，而父亲沈崇山已在厅中等候多时。",
            "dialogue": [
              {
                "speaker": "沈砚之",
                "text": "父亲，孩儿未能及时归来，让您担心了。此玉玦是母亲遗物，苏晚亦是她旧识，非所图。",
                "emotion": "懊恼"
              },
              {
                "speaker": "沈崇山",
                "text": "玉玦……竟是真物？我竟疑心儿郎有负母志，如今见证，才知是我错怪。",
                "emotion": "震惊"
              },
              {
                "speaker": "沈砚之",
                "text": "这些年，孩儿在外奔波，只为查明真相，保母亲遗志。今日得以归来，方知父亲一片深情，竟被误会遮蔽。",
                "emotion": "感慨"
              },
              {
                "speaker": "沈崇山",
                "text": "父亲一意偏执，险些失去儿子。玉玦在手，泪下如雨，悔不该听信谗言，错怪了你们。",
                "emotion": "痛悔"
              }
            ],
            "shot_count": 4,
            "duration_s": 27.0
          },
          {
            "scene_no": 2,
            "location": "沈府大厅",
            "event_ids": [
              "CH03E002"
            ],
            "summary": "沈崇山忏悔对兄妹的亏欠，沈砚之扶起父亲",
            "narration": "",
            "dialogue": [
              {
                "speaker": "C002",
                "text": "是我对不住你们兄妹，这些年苦了你们了。",
                "emotion": "忏悔"
              },
              {
                "speaker": "C001",
                "text": "父亲请起，儿臣知错。",
                "emotion": "平静"
              }
            ],
            "shot_count": 3,
            "duration_s": 15.0
          },
          {
            "scene_no": 3,
            "location": "沈府祖堂",
            "event_ids": [
              "CH03E003"
            ],
            "summary": "苏晚跪拜母亲牌位称归来，福伯在廊下抹泪",
            "narration": "",
            "dialogue": [
              {
                "speaker": "C004",
                "text": "娘，我回来了，女儿不孝。",
                "emotion": "哀伤"
              },
              {
                "speaker": "C003",
                "text": "小姐终于回家了，老奴替小姐高兴。",
                "emotion": "欣慰"
              }
