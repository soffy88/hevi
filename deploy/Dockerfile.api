# hevi API — cftunnel local-build variant
#
# Copies pre-installed .venv from the host build context.
# The venv (Linux amd64 Python 3.14) works directly inside the container.
# This avoids slow git+ssh downloads of private packages (oprim/oskill/obase/omodul)
# and the torch 2 GB download on every fresh image build.
#
# Host context must include .venv/ — remove it from .dockerignore for this build.
# After any `uv sync` on the host, rebuild: docker compose -f deploy/docker-compose-cftunnel.yml build

# venv stage: take the host .venv, then swap CUDA torch for the CPU wheel of the
# same version and drop nvidia-*/cuda-*/triton (~4.5 GB). The host GPU is not
# usable from this container (runc, no device), so CUDA torch was dead weight.
FROM python:3.14-slim AS venv
WORKDIR /app
COPY .venv/ ./.venv/
COPY deploy/slim/strip-cuda-venv.sh /tmp/strip-cuda-venv.sh
RUN ln -sf /usr/local/bin/python3.14 /usr/bin/python3.14 \
    && sh /tmp/strip-cuda-venv.sh /app/.venv

FROM python:3.14-slim

WORKDIR /app

RUN groupadd --system hevi && useradd --system --gid hevi --home-dir /app hevi

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl git nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    # venv scripts have shebang #!/usr/bin/python3.14 (host system Python path)
    && ln -sf /usr/local/bin/python3.14 /usr/bin/python3.14

# CJK 字体单独一层:烧录中文字幕必需(否则 libass 无字形 → 豆腐块)。单独 RUN 是为了
# 不动上面 ffmpeg 那一层的缓存——ffmpeg 的依赖树巨大,慢镜像源上整层重装要几十分钟。
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Chrome Headless (used by Remotion) needs these runtime libraries. Keep this
# separate from the large ffmpeg/node layer so normal API rebuilds stay cached.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 \
    libcups2t64 libxcomposite1 libxdamage1 \
    && rm -rf /var/lib/apt/lists/*

# 零成本线引擎(HEVI_LINE_ENGINE=zero)的本地 TTS:Piper 独立 venv,与宿主 .venv 解耦,
# 可执行文件固定在 /opt/piper/bin/piper(compose 里 HEVI_TALKCRAFT_PIPER 指向它)。
# 音色 .onnx 由 compose 只读挂到 /opt/piper/voices。单独一层,业务代码改动不失效缓存。
RUN python -m venv /opt/piper \
    && /opt/piper/bin/pip install --no-cache-dir piper-tts==1.8.0 \
    && ln -sf /opt/piper/bin/piper /usr/local/bin/piper \
    && mkdir -p /opt/piper/voices

# Copy pre-installed venv (Linux amd64 Python 3.14)
# Scripts in .venv/bin/ have shebangs pointing to the host path
# /data/soffy/projects/hevi/.venv/bin/python3 — create a symlink so they resolve
COPY --from=venv --chown=hevi:hevi /app/.venv ./.venv
RUN mkdir -p /data/soffy/projects/hevi && \
    ln -s /app/.venv /data/soffy/projects/hevi/.venv

# ── v9.1 Lite 管道:Playwright 无头浏览器录屏 ──
# 业务代码拷贝之前独立成层, 正常 API 重建不失效该层缓存。
# --with-deps 顺带补齐 libgtk-3/libgdk-3 等缺失运行库。
# 浏览器运行库由已有生产镜像/宿主缓存提供；避免构建时下载 184MB Chromium 阻塞发布。
# 如需重新启用：/app/.venv/bin/python -m playwright install --with-deps chromium

# App source
COPY hevi-remotion/package.json hevi-remotion/package-lock.json ./hevi-remotion/
RUN cd hevi-remotion && npm ci --omit=dev --no-audit --no-fund

# ── talkcraft 主播线(talking_head / avatar_spokesperson, renderer=talkcraft) ──
# 宿主上 hevi-remotion-talkcraft/node_modules 是软链到仓库外 vendor runtime,不在 build
# context 里(.dockerignore 已排除该软链),所以镜像内按同一份 package-lock 独立安装。
# Chrome Headless Shell 额外运行库(libnss3 等已在上面的 Remotion 层)。
RUN apt-get update && apt-get install -y --no-install-recommends \
    libdrm2 libgbm1 libxkbcommon0 libxfixes3 libxrandr2 libasound2t64 \
    libpango-1.0-0 libcairo2 libdbus-1-3 libexpat1 libxshmfence1 \
    && rm -rf /var/lib/apt/lists/*
ARG NPM_REGISTRY=https://registry.npmmirror.com
COPY hevi-remotion-talkcraft/package.json hevi-remotion-talkcraft/package-lock.json ./hevi-remotion-talkcraft/
RUN cd hevi-remotion-talkcraft \
    && npm ci --omit=dev --no-audit --no-fund --registry="$NPM_REGISTRY" \
    && test -x node_modules/.bin/remotion
# Remotion 4.0.519 期望的 chrome-headless-shell(149.0.7790.0)来自 compose 的
# additional_contexts.talkcraft_browser(宿主 vendor runtime 已下载好的那份),
# 运行时与构建时都不联网下载;下面的 ensure 在断网下跑,版本不符会直接构建失败。
COPY --from=talkcraft_browser . ./hevi-remotion-talkcraft/node_modules/.remotion/
RUN --network=none cd hevi-remotion-talkcraft \
    && node_modules/.remotion/chrome-headless-shell/linux64/chrome-headless-shell-linux64/chrome-headless-shell --version \
    && npx --no-install remotion browser ensure
COPY --chown=hevi:hevi hevi-remotion/ ./hevi-remotion/
COPY --chown=hevi:hevi hevi/ ./hevi/
COPY --chown=hevi:hevi hevi-remotion-talkcraft/ ./hevi-remotion-talkcraft/
# 静态索引(gen-index.ts / tpl-index.ts / mediaManifest.ts / kbMeta.ts)在镜像内重新生成;
# 渲染时 produce.py 写 public/runs/<job>,webpack 缓存写 node_modules/.cache —— 交给 hevi。
RUN cd hevi-remotion-talkcraft && node scripts/gen-index.mjs \
    && mkdir -p public/runs node_modules/.cache \
    && chown -R hevi:hevi src public node_modules/.cache
COPY alembic.ini ./

RUN mkdir -p /app/output /app/data /app/assets /app/.cache/hevi/zerolines /app/.obase/work \
        /app/hevi-remotion/public/runs /app/hevi-remotion/src/data /app/hevi-remotion/public/audio && \
    chown -R hevi:hevi /app/.cache && \
    chown hevi:hevi /app /app/output /app/data /app/assets && \
    chown -R 1000:1000 /app/.obase /app/hevi-remotion/public/runs /app/hevi-remotion/src/data /app/hevi-remotion/public/audio /app/hevi && \
    chmod -R a+rX /app && \
    find /app/hevi-remotion/public/runs /app/hevi-remotion/src/data /app/hevi-remotion/public/audio /app/hevi -exec chmod o+w {} +
USER hevi

# cftunnel: obase 默认 ~/.obase/work,无 HOME 时解析到 /,UID 1000 无权创建
ENV HOME=/app
# Use edge_tts for explainer TTS to avoid voicebox DNS issues
ENV HEVI_EXPLAINER_TTS_PROVIDER=edge_tts
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -sf http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "hevi.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
