# hevi API — cftunnel local-build variant
#
# Copies pre-installed .venv from the host build context.
# The venv (Linux amd64 Python 3.14) works directly inside the container.
# This avoids slow git+ssh downloads of private packages (oprim/oskill/obase/omodul)
# and the torch 2 GB download on every fresh image build.
#
# Host context must include .venv/ — remove it from .dockerignore for this build.
# After any `uv sync` on the host, rebuild: docker compose -f deploy/docker-compose-cftunnel.yml build

FROM python:3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg curl git nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    # venv scripts have shebang #!/usr/bin/python3.14 (host system Python path)
    && ln -sf /usr/local/bin/python3.14 /usr/bin/python3.14

# CJK 字体单独一层:烧录中文字幕必需(否则 libass 无字形 → 豆腐块)。单独 RUN 是为了
# 不动上面 ffmpeg 那一层的缓存——ffmpeg 的依赖树巨大,慢镜像源上整层重装要几十分钟。
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

# Chrome Headless (used by Remotion) needs these runtime libraries. Keep this
# separate from the large ffmpeg/node layer so normal API rebuilds stay cached.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0t64 libatk-bridge2.0-0t64 \
    libcups2t64 libxcomposite1 libxdamage1 \
    && rm -rf /var/lib/apt/lists/*

# Copy pre-installed venv (Linux amd64 Python 3.14)
# Scripts in .venv/bin/ have shebangs pointing to the host path
# /data/soffy/projects/hevi/.venv/bin/python3 — create a symlink so they resolve
COPY .venv/ ./.venv/
RUN mkdir -p /data/soffy/projects/hevi && \
    ln -s /app/.venv /data/soffy/projects/hevi/.venv

# ── v9.1 Lite 管道:Playwright 无头浏览器录屏 ──
# 业务代码拷贝之前独立成层, 正常 API 重建不失效该层缓存。
# --with-deps 顺带补齐 libgtk-3/libgdk-3 等缺失运行库。
# 浏览器运行库由已有生产镜像/宿主缓存提供；避免构建时下载 184MB Chromium 阻塞发布。
# 如需重新启用：/app/.venv/bin/python -m playwright install --with-deps chromium

# App source
COPY hevi-remotion/package.json hevi-remotion/package-lock.json ./hevi-remotion/
RUN cd hevi-remotion && npm ci --omit=dev --no-audit --no-fund
COPY hevi-remotion/ ./hevi-remotion/
COPY hevi/ ./hevi/
COPY alembic.ini ./

RUN groupadd --system hevi && useradd --system --gid hevi --home-dir /app hevi && \
    chown -R hevi:hevi /app
# cftunnel 覆盖层 user: 1000:1000 覆盖镜像的 USER hevi。
# 宿主卷为 1000:1000,镜像内源码/venv 为 999:999 + 700 目录 → 无法遍历。
# 统一给所有文件/目录加上 o+rX,让任何 UID 均可读取导入。
# explainer 配音运行时写入 hevi-remotion/public/runs/<job_id>/,需写权限。
# Remotion 装配也从 src/data/run_manifest.json 读写清单,需写权限。
RUN mkdir -p /app/.obase/work /app/hevi-remotion/public/runs /app/hevi-remotion/src/data && \
    chown -R 1000:1000 /app/.obase /app/hevi-remotion/public/runs /app/hevi-remotion/src/data /app/hevi-remotion/public/audio /app/hevi && \
    chmod -R a+rX /app && \
    find /app/hevi-remotion/public/runs /app/hevi-remotion/src/data /app/hevi-remotion/public/audio /app/hevi -exec chmod o+w {} +
USER hevi

# cftunnel: obase 默认 ~/.obase/work,无 HOME 时解析到 /,UID 1000 无权创建
ENV HOME=/app
# Use edge_tts for explainer TTS to avoid voicebox DNS issues
ENV HEVI_EXPLAINER_TTS_PROVIDER=edge_tts
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -sf http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "hevi.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
