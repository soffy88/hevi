# hevi-web — Next.js 16 / React 19 production image
# Build-time: NEXT_PUBLIC_API_BASE is baked into the JS bundle
# Usage (from deploy/docker-compose-cftunnel.yml):
#   context: ../hevi-web
#   dockerfile: ../deploy/Dockerfile.web

FROM node:22-slim AS deps
WORKDIR /app
ARG NPM_REGISTRY=https://registry.npmmirror.com
COPY package.json package-lock.json ./
COPY vendor/ ./vendor/
RUN npm ci --prefer-offline --registry="$NPM_REGISTRY"

FROM node:22-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_DEPLOY_ENV=production
ARG NEXT_PUBLIC_API_BASE=https://hevi.kanpan.co
ARG NEXT_PUBLIC_USE_MOCK=false
ENV NEXT_PUBLIC_DEPLOY_ENV=$NEXT_PUBLIC_DEPLOY_ENV
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_USE_MOCK=$NEXT_PUBLIC_USE_MOCK
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
RUN chown -R node:node /app
USER node
EXPOSE 3000
# Next.js 生产镜像不含 curl → curl healthcheck 恒失败(假 unhealthy)。
# 与 compose 的 healthcheck 覆盖保持一致: node 自带 http 探活(node 必然存在);
# / 会 307 到 /studio, 故只要求 statusCode<400(307 也算通过)。
HEALTHCHECK --interval=15s --timeout=10s --retries=3 CMD node -e "require('http').get('http://localhost:3000',r=>process.exit(r.statusCode<400?0:1)).on('error',()=>process.exit(1))"
CMD ["npm", "start"]
