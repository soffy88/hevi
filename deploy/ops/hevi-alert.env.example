# Hevi 健康告警配置（/etc/hevi-alert.env）
#
# 全部可选；未设置时使用脚本内默认值。
# 默认不外发任何请求：HEVI_ALERT_WEBHOOK_URL 留空即关闭 webhook。
HEVI_ALERT_WEBHOOK_URL="${HEVI_ALERT_WEBHOOK_URL:-}"
HEVI_ALERT_WEBHOOK_TIMEOUT_S="${HEVI_ALERT_WEBHOOK_TIMEOUT_S:-5}"

# 巡检目标与阈值
HEVI_CHECK_WEB_URL="${HEVI_CHECK_WEB_URL:-http://127.0.0.1:3200/}"
HEVI_CHECK_API_URL="${HEVI_CHECK_API_URL:-http://127.0.0.1:8201/api/health}"
HEVI_CHECK_MIN_FREE_GB="${HEVI_CHECK_MIN_FREE_GB:-15}"
HEVI_CHECK_DISK_PATH="${HEVI_CHECK_DISK_PATH:-/data}"
HEVI_CHECK_TIMEOUT_S="${HEVI_CHECK_TIMEOUT_S:-10}"
HEVI_CHECK_CONTAINERS="${HEVI_CHECK_CONTAINERS:-hevi-cftunnel-hevi-api-1 hevi-cftunnel-hevi-worker-1 hevi-cftunnel-hevi-scheduler-1 hevi-cftunnel-hevi-web-1 hevi-cftunnel-hevi-redis-1}"
