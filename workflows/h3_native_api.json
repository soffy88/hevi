{
  "load_unet": {"class_type": "UNETLoader", "inputs": {"unet_name": "minimax_h3_fl2va_pruned_w4a8_mixed.safetensors", "weight_dtype": "default"}},
  "load_clip": {"class_type": "CLIPLoaderGGUF", "inputs": {"clip_name": "qwen3vl-32B-MiniMax-H3-Q2_K.gguf", "type": "minimax"}},
  "load_video_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
  "load_audio_vae": {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
  "sigma_shift": {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["load_unet", 0], "shift_video": 12.0, "shift_audio": 3.0}},
  "h3": {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["load_clip", 0], "vae": ["load_video_vae", 0], "prompt": "A mechanical robot in a cyber garage looking surprised. The robot says: \"System fully online!\"", "width": 768, "height": 432, "length": 124}},
  "guider": {"class_type": "BasicGuider", "inputs": {"model": ["sigma_shift", 0], "conditioning": ["h3", 0]}},
  "noise": {"class_type": "RandomNoise", "inputs": {"noise_seed": 20260910}},
  "sampler": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "res_multistep"}},
  "sched": {"class_type": "BasicScheduler", "inputs": {"model": ["sigma_shift", 0], "scheduler": "simple", "steps": 4, "denoise": 1.0}},
  "sample": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sched", 0], "latent_image": ["h3", 1]}},
  "vae_decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["load_video_vae", 0]}},
  "vae_decode_audio": {"class_type": "VAEDecodeAudio", "inputs": {"samples": ["sample", 0], "vae": ["load_audio_vae", 0]}},
  "create_video": {"class_type": "CreateVideo", "inputs": {"images": ["vae_decode", 0], "fps": 24.0, "audio": ["vae_decode_audio", 0]}},
  "save": {"class_type": "SaveVideo", "inputs": {"video": ["create_video", 0], "filename_prefix": "h3_native", "format": "mp4", "codec": "auto"}}
}
